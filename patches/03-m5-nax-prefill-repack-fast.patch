+inline float2 tree_even(uint packed) {
+    const uint mag = packed & 0x007f007fu;
+    const float2 finite = float2(as_type<half2>((mag << 7) | ((packed & 0x00800080u) << 8)));
+    return select(finite, float2(NAN), as_type<ushort2>(mag) == ushort2(127));
+}
+
+inline float tree_dot32_packed(const device uchar* x, const device uchar* w) {
+    float sum = 0;
+    #pragma unroll
+    for (uint half_block = 0; half_block < 2; ++half_block) {
+        float2 pairs[4];
+        const uint4 left = *(const device uint4*)(x + 16 * half_block);
+        const uint4 right = *(const device uint4*)(w + 16 * half_block);
+        #pragma unroll
+        for (uint j = 0; j < 4; ++j) {
+            const float2 xe = tree_even(left[j]), xo = tree_even(left[j] >> 8);
+            const float2 we = tree_even(right[j]), wo = tree_even(right[j] >> 8);
+            pairs[j] = xe * we + xo * wo;
+        }
+        sum += pairs[0][0] + pairs[2][0];
+        sum += pairs[0][1] + pairs[2][1];
+        sum += pairs[1][0] + pairs[3][0];
+        sum += pairs[1][1] + pairs[3][1];
+    }
+    return sum * 65536.0f;
+}
+
+template<uint C>
+kernel void tree_rows_packed(const device uchar* x [[buffer(0)]], const device uchar* w [[buffer(1)]],
+                             const device uchar* sw [[buffer(2)]], device bfloat* y [[buffer(3)]],
+                             constant OrderedArgs& a [[buffer(4)]], const device float* sx [[buffer(5)]],
+                             uint3 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {
+    const uint c0 = tg.x * C, r = tg.y, groups = a.k / 32;
+    x += long(tg.z) * a.xs; sx += long(tg.z) * a.sxs;
+    w += long(tg.z) * a.ws; sw += long(tg.z) * a.ss;
+    y = (device bfloat*)((device char*)y + long(tg.z) * a.ys);
+    float sum[C] = {};
+    for (uint base = 0; base < groups; base += 32) {
+        const uint g = base + lane;
+        float t[C] = {};
+        if (g < groups) {
+            const uint code = sw[(c0 / 32) * groups + g];
+            const float ws = code == 255 ? NAN : as_type<float>(code == 0 ? 0x00400000u : code << 23);
+            const float xs = sx[r * groups + g];
+            #pragma unroll
+            for (uint i = 0; i < C; i++)
+                t[i] = (tree_dot32_packed(x + r * a.k + 32 * g, w + (c0 + i) * a.k + 32 * g) * xs) * ws;
+        }
+        for (uint j = 0; j < min(32u, groups - base); j++) {
+            #pragma unroll
+            for (uint i = 0; i < C; i++) sum[i] += simd_shuffle(t[i], ushort(j));
+        }
+    }
+    if (lane == 0) for (uint i = 0; i < C; i++) y[r * a.n + c0 + i] = bfloat(sum[i]);
+}
+template [[host_name("tree_rows_packed_1")]] [[kernel]] decltype(tree_rows_packed<1>) tree_rows_packed<1>;
+
+inline float bf_dot32(const device bfloat* x, const device bfloat* w) {
+    float sum = 0;
+    #pragma unroll
+    for (uint h = 0; h < 2; h++) {
+        float2 pairs[4];
+        #pragma unroll
+        for (uint j = 0; j < 4; j++) {
+            const uint start = 16 * h + 4 * j;
+            float4 a = float4(*(const device bfloat4*)(x + start));
+            float4 b = float4(*(const device bfloat4*)(w + start));
+            const float4 p = a * b;
+            pairs[j] = p.xz + p.yw;
+        }
+        sum += pairs[0][0] + pairs[2][0];
+        sum += pairs[0][1] + pairs[2][1];
+        sum += pairs[1][0] + pairs[3][0];
+        sum += pairs[1][1] + pairs[3][1];
+    }
+    return sum;
+}
+
+template <uint C, typename Out>
+kernel void bf_tree_rows(const device bfloat* x [[buffer(0)]], const device bfloat* w [[buffer(1)]],
+                         device Out* y [[buffer(2)]], constant WoaArgs& a [[buffer(3)]],
+                         uint3 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {
+    const uint c0 = tg.x * C, r = tg.y, h = tg.z, groups = a.k / 32;
+    x += (ulong(h) * a.rows + r) * a.k; w += (ulong(h) * a.n + c0) * a.k; y += (ulong(h) * a.rows + r) * a.n + c0;
+    float sum[C] = {}, res[C] = {};
+    for (uint base = 0; base < groups; base += 32) {
+        const uint g = base + lane;
+        float t[C] = {};
+        if (g < groups) {
+            #pragma unroll
+            for (uint i = 0; i < C; i++) t[i] = bf_dot32(x + 32 * g, w + i * a.k + 32 * g);
+        }
+        for (uint j = 0; j < min(32u, groups - base); j++) {
+            #pragma unroll
+            for (uint i = 0; i < C; i++) {
+                const float adjusted = simd_shuffle(t[i], ushort(j)) - res[i], updated = sum[i] + adjusted;
+                res[i] = (updated - sum[i]) - adjusted;
+                sum[i] = updated;
+            }
+        }
+    }
+    if (lane == 0) for (uint i = 0; i < C; i++) y[i] = Out(sum[i]);
+}
+template [[host_name("bf_tree_bf16_1")]] [[kernel]] decltype(bf_tree_rows<1,bfloat>) bf_tree_rows<1,bfloat>;
+template [[host_name("bf_tree_f32_1")]] [[kernel]] decltype(bf_tree_rows<1,float>) bf_tree_rows<1,float>;
