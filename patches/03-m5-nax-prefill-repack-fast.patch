diff --git a/zig/kernels/metal/deepseek_v41/attention_nax.metal b/zig/kernels/metal/deepseek_v41/attention_nax.metal
new file mode 100644
index 0000000..e960bf1
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/attention_nax.metal
@@ -0,0 +1,265 @@
+// Continuous 16-head NAX CSA2 attention appended to csa2_attn.metal (zero edits to upstream csa2_attn.metal).
+// Supports optional compile-time macros:
+//   TF_DSV41_GROUPED_WOA: fuse act_quant + group-major [8][rows][4096] transpose directly into output.
+//   TF_DSV41_SPLIT_ATTENTION_VALUES: split 512 value dims across 4 threadgroups (tg.z = 0..3) for small R<=8 decode.
+//   TF_DSV41_ATTN_FAST: direct NAX accumulate without Kahan compensation + fast exp2 for maximum prefill speed.
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+using af8 = vec<float, 8>;
+using ab8 = vec<bfloat, 8>;
+using ab4 = vec<bfloat, 4>;
+
+template<bool transpose_right>
+inline void attention_mma(thread af8& low, thread af8& high, ab8 a, ab8 b0, ab8 b1) {
+    constexpr auto desc = matmul2d_descriptor(16, 32, 16, false, transpose_right, false,
+                                              matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<desc, execution_simdgroup> op;
+    auto l = op.template get_left_input_cooperative_tensor<bfloat, bfloat, float>();
+    auto r = op.template get_right_input_cooperative_tensor<bfloat, bfloat, float>();
+    auto out = op.template get_destination_cooperative_tensor<metal::remove_addrspace_t<decltype(l)>,
+                  metal::remove_addrspace_t<decltype(r)>, float>();
+    #pragma clang loop unroll(full)
+    for (int i = 0; i < 8; ++i) { l[i] = a[i]; r[i] = b0[i]; r[i + 8] = b1[i]; out[i] = low[i]; out[i + 8] = high[i]; }
+    op.run(l, r, out);
+    #pragma clang loop unroll(full)
+    for (int i = 0; i < 8; ++i) { low[i] = out[i]; high[i] = out[i + 8]; }
+}
+
+inline void nax_score_tile(const device bfloat* q, const device bfloat* w, const device bfloat* c,
+                           const threadgroup int* keys, uint head, uint key, uint fm, uint fn, threadgroup float* score) {
+    constexpr auto spec = matmul2d_descriptor(16, 16, 32, false, true, false, matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<spec, execution_simdgroup> op;
+    auto left = op.template get_left_input_cooperative_tensor<bfloat, bfloat, float>();
+    auto right = op.template get_right_input_cooperative_tensor<bfloat, bfloat, float>();
+    auto out = op.template get_destination_cooperative_tensor<metal::remove_addrspace_t<decltype(left)>,
+                 metal::remove_addrspace_t<decltype(right)>, float>();
+    #pragma clang loop unroll(full)
+    for (uint i = 0; i < 8; i++) out[i] = 0.0f;
+
+    const int k0 = keys[key + fm], k1 = keys[key + fm + 8];
+    const device bfloat* first = k0 >= 0 ? w + ulong(k0) * 512 : k0 < -1 ? c + ulong(-2 - k0) * 512 : nullptr;
+    const device bfloat* second = k1 >= 0 ? w + ulong(k1) * 512 : k1 < -1 ? c + ulong(-2 - k1) * 512 : nullptr;
+    const device bfloat* q0 = q + (head + fm) * 512, *q1 = q0 + 8 * 512;
+    #pragma clang loop unroll_count(2)
+    for (uint d = fn; d < 512; d += 32) {
+        #pragma clang loop unroll(full)
+        for (uint slice = 0; slice < 2; slice++) {
+            const uint pos = d + 16 * slice;
+            const ab4 a0 = *(const device ab4*)(q0 + pos), a1 = *(const device ab4*)(q1 + pos);
+            const ab4 b0 = first ? *(const device ab4*)(first + pos) : ab4(0);
+            const ab4 b1 = second ? *(const device ab4*)(second + pos) : ab4(0);
+            #pragma clang loop unroll(full)
+            for (uint i = 0; i < 4; i++) {
+                left[8 * slice + i] = a0[i]; left[8 * slice + 4 + i] = a1[i];
+                right[8 * slice + i] = b0[i]; right[8 * slice + 4 + i] = b1[i];
+            }
+        }
+        op.run(left, right, out);
+    }
+    const uint pos = (head + fm) * 64 + key + fn;
+    *(threadgroup float4*)(score + pos) = float4(out[0], out[1], out[2], out[3]);
+    *(threadgroup float4*)(score + pos + 8 * 64) = float4(out[4], out[5], out[6], out[7]);
+}
+
+inline ab4 nax_sparse_value(const device bfloat* w, const device bfloat* c, int key, uint d) {
+    if (key == -1) return ab4(0);
+    const device bfloat* data = key >= 0 ? w : c;
+    const uint ix = key >= 0 ? uint(key) : uint(-2 - key);
+    return *(const device ab4*)(data + ulong(ix) * 512 + d);
+}
+
+#ifdef TF_DSV41_GROUPED_WOA
+inline int nax_log2c(float v) {
+    const uint b = as_type<uint>(v);
+    return int(b >> 23) - 127 + int((b & 0x7FFFFFu) != 0);
+}
+inline float nax_pow2(int e) { return as_type<float>(uint(e + 127) << 23); }
+inline uint nax_e4m3(float a) {
+    if (a < 0.015625f) return uint(rint(a * 512.0f));
+    uint b = as_type<uint>(a);
+    b += 0x7FFFFu + ((b >> 20) & 1u);
+    return (((b >> 23) - 120u) << 3) | ((b >> 20) & 7u);
+}
+inline float nax_e4m3v(uint c) { return float(as_type<half>(ushort((c & 0x7Fu) << 7))) * 256.0f; }
+#endif
+
+#ifdef TF_DSV41_SPLIT_ATTENTION_VALUES
+#define TF_ATTN_PAIR_GRID uint3
+#define TF_ATTN_VALUE_VECTORS 2u
+#define TF_ATTN_VALUE_BASE (tg.z * 32u)
+#else
+#define TF_ATTN_PAIR_GRID uint2
+#define TF_ATTN_VALUE_VECTORS 8u
+#define TF_ATTN_VALUE_BASE 0u
+#endif
+
+inline float nax_exp(float x) {
+#ifdef TF_DSV41_ATTN_FAST
+    return exp2(x * 1.4426950408889634f);
+#else
+    return precise::exp(x);
+#endif
+}
+
+[[kernel, max_total_threads_per_threadgroup(128)]] void tf_dsv41_attn_nax16(
+    const device bfloat* Q [[buffer(0)]], const device bfloat* W [[buffer(1)]],
+    const device bfloat* C [[buffer(2)]], const device int* I [[buffer(3)]],
+    const device TfAttnMeta* M [[buffer(4)]], const device float* SK [[buffer(5)]],
+    const device float* CS [[buffer(6)]], device bfloat* O [[buffer(7)]],
+    constant TfAttnArgs& a [[buffer(8)]], TF_ATTN_PAIR_GRID tg [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]], uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    uint work = tg.y * a.rows + tg.x;
+    uint row = work / (a.heads / 16), headbase = (work % (a.heads / 16)) * 16;
+    TfAttnMeta m = M[row];
+    int first = max(0, m.pos + 1 - 128), valid = m.pos - first + 1;
+    int width = a.pad ? int(a.pad) : 128, skip = a.pad ? 0 : width - valid;
+    uint fm = (lane >> 2 & 4) | ((lane >> 1) & 3), fn = ((lane >> 2 & 2) | (lane & 1)) * 4;
+    uint head16 = (sg / 4) * 16, h = head16 + fm, key16 = (sg & 3) * 16;
+    threadgroup int keys[64];
+    threadgroup float partial[16][64];
+    threadgroup bfloat prob[16][64];
+    threadgroup float maxima[16], denom[16], factor[16];
+    if (tid < 16) { maxima[tid] = -1e30f; denom[tid] = 0; }
+    af8 accum[TF_ATTN_VALUE_VECTORS];
+    #pragma clang loop unroll(full)
+    for (uint j = 0; j < TF_ATTN_VALUE_VECTORS; ++j) accum[j] = 0.0f;
+    for (int base = 0; base < width + m.ncomp; base += 64) {
+        if (base + 64 <= skip) continue;
+        if (tid < 64) {
+            int logical = base + int(tid), loc = -1;
+            if (logical < width) {
+                int pos = first + logical - skip;
+                if (pos >= first && pos <= m.pos) loc = int(tf_attn_window_row(m, pos));
+            } else if (logical < width + m.ncomp) {
+                int id = I[ulong(row) * 512 + logical - width];
+                if (id >= 0) loc = -2 - (m.cofs + id);
+            }
+            keys[tid] = loc;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        const device bfloat* qbase = Q + (ulong(row) * a.heads + headbase) * 512;
+        nax_score_tile(qbase, W, C, keys, head16, key16, fm, fn, &partial[0][0]);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint head = sg; head < 16; head += 4) {
+            float s0 = keys[lane] != -1 ? partial[head][lane] * a.scale : -INFINITY;
+            float s1 = keys[lane + 32] != -1 ? partial[head][lane + 32] * a.scale : -INFINITY;
+            float old = maxima[head];
+            float current = max(old, simd_max(max(s0, s1)));
+            float p0 = nax_exp(s0 - current), p1 = nax_exp(s1 - current);
+            prob[head][lane] = bfloat(p0); prob[head][lane + 32] = bfloat(p1);
+            float total = simd_sum(p0 + p1);
+            if (lane == 0) {
+                float f = nax_exp(old - current);
+                factor[head] = f; denom[head] = denom[head] * f + total; maxima[head] = current;
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        #pragma clang loop unroll(full)
+        for (uint j = 0; j < TF_ATTN_VALUE_VECTORS; ++j) {
+            for (uint i = 0; i < 8; ++i) accum[j][i] *= factor[h + (i >= 4 ? 8 : 0)];
+        }
+        uint d0 = (sg % 4) * 128 + fn + TF_ATTN_VALUE_BASE;
+        #pragma clang loop unroll(full)
+        for (uint first_j = 0; first_j < TF_ATTN_VALUE_VECTORS; first_j += 2) {
+#ifdef TF_DSV41_ATTN_FAST
+            af8 p0 = accum[first_j], p1 = accum[first_j + 1];
+            #pragma clang loop unroll_count(2)
+            for (uint t = 0; t < 4; t++) {
+                uint kk = t * 16;
+                ab8 p = ab8(*(threadgroup ab4*)(&prob[h][kk + fn]), *(threadgroup ab4*)(&prob[h + 8][kk + fn]));
+                const int k0 = keys[kk + fm], k1 = keys[kk + fm + 8];
+                uint d = d0 + first_j * 16;
+                ab8 v0 = ab8(nax_sparse_value(W, C, k0, d), nax_sparse_value(W, C, k1, d));
+                ab8 v1 = ab8(nax_sparse_value(W, C, k0, d + 16), nax_sparse_value(W, C, k1, d + 16));
+                attention_mma<false>(p0, p1, p, v0, v1);
+            }
+            accum[first_j] = p0; accum[first_j + 1] = p1;
+#else
+            af8 parts[2], err[2];
+            #pragma clang loop unroll(full)
+            for (uint sub = 0; sub < 2; sub++) { parts[sub] = accum[first_j + sub]; err[sub] = 0.0f; }
+            #pragma clang loop unroll_count(2)
+            for (uint t = 0; t < 4; t++) {
+                uint kk = t * 16;
+                ab8 p = ab8(*(threadgroup ab4*)(&prob[h][kk + fn]), *(threadgroup ab4*)(&prob[h + 8][kk + fn]));
+                const int k0 = keys[kk + fm], k1 = keys[kk + fm + 8];
+                uint d = d0 + first_j * 16;
+                ab8 v0 = ab8(nax_sparse_value(W, C, k0, d), nax_sparse_value(W, C, k1, d));
+                ab8 v1 = ab8(nax_sparse_value(W, C, k0, d + 16), nax_sparse_value(W, C, k1, d + 16));
+                af8 a0 = 0.0f, a1 = 0.0f;
+                attention_mma<false>(a0, a1, p, v0, v1);
+                af8 y0 = a0 - err[0], y1 = a1 - err[1];
+                af8 s0 = parts[0] + y0, s1 = parts[1] + y1;
+                err[0] = (s0 - parts[0]) - y0; err[1] = (s1 - parts[1]) - y1;
+                parts[0] = s0; parts[1] = s1;
+            }
+            #pragma clang loop unroll(full)
+            for (uint sub = 0; sub < 2; sub++) accum[first_j + sub] = parts[sub];
+#endif
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+#ifdef TF_DSV41_GROUPED_WOA
+    for (uint r = 0; r < 2; ++r) {
+        const uint head = h + r * 8, absolute_head = headbase + head;
+        const float den = denom[head] + precise::exp(SK[headbase + head] - maxima[head]);
+        for (uint j = 0; j < 8; j += 2) {
+            float values[8];
+            float peak = 0.0f;
+            uint bad = 0;
+            #pragma unroll
+            for (uint t = 0; t < 2; ++t) {
+                const uint d = (sg % 4) * 128 + 16 * (j + t) + fn;
+                #pragma unroll
+                for (uint i = 0; i < 4; i += 2) {
+                    float2 v = float2(bfloat2(float2(accum[j + t][r * 4 + i], accum[j + t][r * 4 + i + 1]) / den));
+                    if (d >= 448) {
+                        const uint pair = (d + i - 448) / 2;
+                        const device float* cs = CS + ulong(m.pos + m.rope) * 64;
+                        v = float2(v.x * cs[pair] + v.y * cs[32 + pair], v.y * cs[pair] - v.x * cs[32 + pair]);
+                    }
+                    v = float2(bfloat2(v));
+                    values[4 * t + i] = v.x; values[4 * t + i + 1] = v.y;
+                    peak = max(peak, max(fabs(v.x), fabs(v.y)));
+                    bad |= uint(!all(isfinite(v)));
+                }
+            }
+            peak = max(peak, simd_shuffle_xor(peak, 1));
+            peak = max(peak, simd_shuffle_xor(peak, 8));
+            bad |= simd_shuffle_xor(bad, 1);
+            bad |= simd_shuffle_xor(bad, 8);
+            const int e = nax_log2c(max(peak, 1e-4f) * (1.0f / 448.0f));
+            #pragma unroll
+            for (uint t = 0; t < 2; ++t) {
+                const uint d = (sg % 4) * 128 + 16 * (j + t) + fn;
+                const ulong start = (ulong(absolute_head / 8) * a.rows + row) * 4096 + (absolute_head % 8) * 512 + d;
+                #pragma unroll
+                for (uint i = 0; i < 4; ++i) {
+                    const float v = values[4 * t + i];
+                    const float q = nax_e4m3v(nax_e4m3(min(fabs(v) * nax_pow2(-e), 448.0f))) * nax_pow2(e);
+                    O[start + i] = bfloat(bad ? NAN : (signbit(v) ? -q : q));
+                }
+            }
+        }
+    }
+#else
+    for (uint r = 0; r < 2; ++r) {
+        uint head = h + r * 8;
+        float den = denom[head] + precise::exp(SK[headbase + head] - maxima[head]);
+        for (uint j = 0; j < TF_ATTN_VALUE_VECTORS; ++j) {
+            uint d = (sg % 4) * 128 + 16 * j + fn + TF_ATTN_VALUE_BASE;
+            for (uint i = 0; i < 4; i += 2) {
+                float2 v = float2(bfloat2(float2(accum[j][r * 4 + i], accum[j][r * 4 + i + 1]) / den));
+                if (d >= 448) {
+                    uint pair = (d + i - 448) / 2;
+                    const device float* cs = CS + ulong(m.pos + m.rope) * 64;
+                    v = float2(v.x * cs[pair] + v.y * cs[32 + pair], v.y * cs[pair] - v.x * cs[32 + pair]);
+                }
+                ulong k = (ulong(row) * a.heads + headbase + head) * 512 + d + i;
+                O[k] = bfloat(v.x); O[k + 1] = bfloat(v.y);
+            }
+        }
+    }
+#endif
+}
diff --git a/zig/kernels/metal/deepseek_v41/experts_direct.metal b/zig/kernels/metal/deepseek_v41/experts_direct.metal
new file mode 100644
index 0000000..2b5b12a
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/experts_direct.metal
@@ -0,0 +1,140 @@
+// Appended to experts.metal (zero edits to upstream experts.metal / experts_kimi.metal).
+// 1) tf_dsv41_xp_combine_prompt2: 2-column vectorized prompt combine for 384 experts, topk=6.
+// 2) tf_dsv41_xp_upc_direct / tf_dsv41_xp_down_direct: single-dispatch mixed singleton + multi-row verify kernels using ds_fp4_word.
+
+kernel void tf_dsv41_xp_combine_prompt2(device const bfloat2* values [[buffer(0)]],
+                                        device const uint* where [[buffer(1)]],
+                                        device float2* output [[buffer(3)]],
+                                        device const uint* ids [[buffer(4)]],
+                                        constant XpArgs& args [[buffer(5)]],
+                                        uint2 gid [[thread_position_in_grid]]) {
+  const uint stride = args.N / 2;
+  if (gid.x >= stride) return;
+  float2 groups[8] = {};
+  const uint base = gid.y * 6;
+#pragma unroll
+  for (uint rank = 0; rank < 6; ++rank) {
+    const uint slot = where[base + rank];
+    if (slot == NOWHERE) continue;
+    const uint group = ids[base + rank] / 48;
+    groups[group] = fma(float2(1.0f), float2(values[slot * stride + gid.x]), groups[group]);
+  }
+  output[gid.y * stride + gid.x] = ((groups[0] + groups[1]) + (groups[2] + groups[3])) +
+                                    ((groups[4] + groups[5]) + (groups[6] + groups[7]));
+}
+
+template <uint RP, uint NW, typename T, bool DOWN>
+inline void ds_rows_chains_word(thread float (&acc)[NW][RP], device const T* X, device const float* XS,
+                                const thread uint (&src)[RP], uint K, device const uchar* const thread (&wp)[NW],
+                                device const uchar* const thread (&ws)[NW], uint c) {
+  const uint G = K / 32;
+  for (uint v = 0; v < NW; ++v)
+    for (uint r = 0; r < RP; ++r) acc[v][r] = 0.0f;
+  for (uint g = c; g < G; g += 8) {
+    float s[NW][RP];
+    for (uint v = 0; v < NW; ++v)
+      for (uint r = 0; r < RP; ++r) s[v][r] = 0.0f;
+    for (int h = 0; h < 2; ++h) {
+      float w[NW][16];
+      for (uint v = 0; v < NW; ++v) {
+        const uint2 q = *(device const uint2*)(wp[v] + 16 * g + 8 * h);
+        float lo[8], hi[8];
+        ds_fp4_word(q.x, lo);
+        ds_fp4_word(q.y, hi);
+        for (uint i = 0; i < 8; ++i) w[v][i] = lo[i], w[v][i + 8] = hi[i];
+      }
+      for (uint r = 0; r < RP; ++r) {
+        device const vec<T, 4>* x = (device const vec<T, 4>*)(X + src[r] * K + 32 * g + 16 * h);
+        for (int i = 0; i < 4; ++i) {
+          const float4 x4 = float4(x[i]);
+          for (int j = 0; j < 4; ++j)
+            for (uint v = 0; v < NW; ++v) s[v][r] = fma(x4[j], w[v][4 * i + j], s[v][r]);
+        }
+      }
+    }
+    for (uint v = 0; v < NW; ++v)
+      for (uint r = 0; r < RP; ++r) {
+        const float xsc = DOWN ? 1.0f : XS[src[r] * G + g];
+        acc[v][r] = k3_scaled_fma(s[v][r] * xsc, ws[v][g], acc[v][r]);
+      }
+  }
+}
+
+template <uint RP>
+inline void ds_upc_pass_direct(threadgroup float* vals, device const half* XH, device const float* XS,
+                               device const uint* pairs, device bfloat* act, constant DsArgs& a, device const float* wts,
+                               device const uchar* const thread (&wp)[2], device const uchar* const thread (&ws)[2],
+                               uint first, uint r0, uint rn, uint nl, uint n, uint c) {
+  uint src[RP];
+  for (uint r = 0; r < RP; ++r) src[r] = pairs[first + r0 + min(r, rn - 1)] / a.topk;
+  float acc[2][RP];
+  ds_rows_chains_word<RP, 2, half, false>(acc, XH, XS, src, a.K, wp, ws, c);
+  ds_up_out<RP>(acc, *(threadgroup float(*)[RP][32])vals, act, wts, pairs, a, first, r0, rn, nl, n, c);
+}
+
+[[kernel, max_total_threads_per_threadgroup(256)]] void tf_dsv41_xp_upc_direct(
+    device const half* XH [[buffer(0)]], device const ExpertPtrs* table [[buffer(1)]],
+    device const uint* slots [[buffer(2)]], device const uint* nslots [[buffer(3)]],
+    device const uint* pairs [[buffer(4)]], device bfloat* act [[buffer(5)]], constant DsArgs& a [[buffer(6)]],
+    device const float* wts [[buffer(7)]], device const float* XS [[buffer(8)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+  threadgroup float vals[8 * 32];
+  if (tg.y >= nslots[0]) return;
+  const uint e = slots[3 * tg.y], first = slots[3 * tg.y + 1], count = slots[3 * tg.y + 2];
+  const ExpertPtrs w = table[e];
+  const uint nl = sg * 4 + (lane >> 3), n = tg.x * 32 + nl, c = lane & 7, rowb = a.K / 2, groups = a.K / 32;
+  device const uchar* const wp[2] = {w.w1p + n * rowb, w.w3p + n * rowb};
+  device const uchar* const ws[2] = {w.w1s + n * groups, w.w3s + n * groups};
+  if (count == 1) {
+    ds_upc_pass_direct<1>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, 0, 1, nl, n, c);
+    return;
+  }
+  for (uint r0 = 0, rp; r0 < count; r0 += rp) {
+    rp = ds_tier(count - r0, false);
+    const uint rn = min(rp, count - r0);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (rp == 2) ds_upc_pass_direct<2>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, r0, rn, nl, n, c);
+    else if (rp == 4) ds_upc_pass_direct<4>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, r0, rn, nl, n, c);
+    else if (rp == 6) ds_upc_pass_direct<6>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, r0, rn, nl, n, c);
+    else ds_upc_pass_direct<8>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, r0, rn, nl, n, c);
+  }
+}
+
+template <uint RP>
+inline void ds_down_pass_direct(device const bfloat* act, device bfloat* out, constant XpArgs& a,
+                                device const uchar* const thread (&wp)[1], device const uchar* const thread (&ws)[1],
+                                uint first, uint r0, uint rn, uint n, uint c) {
+  uint src[RP];
+  for (uint r = 0; r < RP; ++r) src[r] = first + r0 + min(r, rn - 1);
+  float acc[1][RP];
+  ds_rows_chains_word<RP, 1, bfloat, true>(acc, act, nullptr, src, a.K, wp, ws, c);
+  for (uint r = 0; r < RP; ++r) {
+    const float v = k3_xtree8(acc[0][r]);
+    if (c == 0 && r < rn) out[(first + r0 + r) * a.N + n] = bfloat(v);
+  }
+}
+
+[[kernel, max_total_threads_per_threadgroup(256)]] void tf_dsv41_xp_down_direct(
+    device const bfloat* act [[buffer(0)]], device const ExpertPtrs* table [[buffer(1)]],
+    device const uint* slots [[buffer(2)]], device const uint* nslots [[buffer(3)]],
+    device const uint* pairs [[buffer(4)]], device bfloat* out [[buffer(5)]], constant XpArgs& a [[buffer(6)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+  if (tg.y >= nslots[0]) return;
+  const uint e = slots[3 * tg.y], first = slots[3 * tg.y + 1], count = slots[3 * tg.y + 2];
+  const ExpertPtrs w = table[e];
+  const uint n = tg.x * 32 + sg * 4 + (lane >> 3), c = lane & 7, rowb = a.K / 2, groups = a.K / 32;
+  device const uchar* const wp[1] = {w.w2p + n * rowb};
+  device const uchar* const ws[1] = {w.w2s + n * groups};
+  if (count == 1) {
+    ds_down_pass_direct<1>(act, out, a, wp, ws, first, 0, 1, n, c);
+    return;
+  }
+  for (uint r0 = 0, rp; r0 < count; r0 += rp) {
+    rp = ds_tier(count - r0, true);
+    const uint rn = min(rp, count - r0);
+    if (rp == 2) ds_down_pass_direct<2>(act, out, a, wp, ws, first, r0, rn, n, c);
+    else ds_down_pass_direct<4>(act, out, a, wp, ws, first, r0, rn, n, c);
+  }
+}
diff --git a/zig/kernels/metal/deepseek_v41/fold_expert.metal b/zig/kernels/metal/deepseek_v41/fold_expert.metal
new file mode 100644
index 0000000..4082176
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/fold_expert.metal
@@ -0,0 +1,76 @@
+// Appended to fold.metal (zero edits to upstream fold.metal).
+// Fuses routed-expert act_quant (half codes + float scales) into hc_post + prenorm.
+inline bfloat tf_o_actq_expert(float v, thread half& expert_code, thread float& expert_scale) {
+  const bool bad = simd_any(!isfinite(v));
+  const float amax = simd_max(fabs(v));
+  const int e = tf_o_log2c(max(amax, 1e-4f) * (1.0f / 448.0f));
+  const uint code = tf_o_e4m3(min(fabs(v) * tf_o_pow2(-e), 448.0f));
+  const float q = tf_o_e4m3v(code) * tf_o_pow2(e);
+  uint raw = code;
+  if (bad) {
+    float peak = 0.0f;
+    for (ushort j = 0; j < 32; ++j) peak = max(peak, fabs(simd_shuffle(v, j)));
+    const int block_e = tf_o_log2c(max(peak, 1e-4f) * (1.0f / 448.0f));
+    raw = tf_o_e4m3(min(fabs(v) * tf_o_pow2(-block_e), 448.0f));
+  }
+  const ushort bits = ushort((raw & 127u) << 7) | (signbit(v) ? 0x8000u : 0u);
+  expert_code = half(float(as_type<half>(bits)) * 256.0f);
+  expert_scale = bad ? NAN : tf_o_pow2(e);
+  return bfloat(bad ? NAN : (signbit(v) ? -q : q));
+}
+
+[[kernel, max_total_threads_per_threadgroup(TF_O_TG)]] void tf_dsv41_o_postnorm_expert(
+    const device bfloat* X [[buffer(0)]], const device float* PRE [[buffer(1)]], const device float* Wt [[buffer(2)]],
+    device bfloat* H [[buffer(3)]], device bfloat* HN [[buffer(4)]], device bfloat* HQ [[buffer(5)]],
+    constant TfONormArgs& a [[buffer(6)]], const device bfloat* BR [[buffer(7)]], const device float* PO [[buffer(8)]],
+    const device float* CB [[buffer(9)]], device bfloat* X1 [[buffer(10)]],
+    device half* XH [[buffer(11)]], device float* XS [[buffer(12)]], uint r [[threadgroup_position_in_grid]],
+    uint t [[thread_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float hs[TF_O_MAX];
+  threadgroup float part[8];
+  if (r >= a.rows) return;
+  const device bfloat* x = X + ulong(r) * 4u * a.dim;
+  const device float* p = PRE + r * 4u;
+  const float p0 = p[0], p1 = p[TF_CTL == 2 ? 2 : 1], p2 = p[TF_CTL == 2 ? 1 : 2], p3 = p[3];
+  for (uint i = t; i < a.dim; i += TF_O_TG) {
+    float v[4];
+    for (uint k = 0; k < 4; ++k) v[k] = tf_o_in(float(x[k * a.dim + i]));
+    const float b = tf_o_in(float(BR[ulong(r) * a.dim + i]));
+    const device float* c = CB + r * 16u;
+    float o[4];
+    for (uint k = 0; k < 4; ++k) {
+      const float mm = ((c[k] * v[0] + c[4 + k] * v[1]) + c[8 + k] * v[2]) + c[12 + k] * v[3];
+      const bfloat ok = bfloat(PO[r * 4u + k] * b + mm);
+      X1[ulong(r) * 4u * a.dim + k * a.dim + i] = ok;
+      o[k] = float(ok);
+    }
+    const float y = float(bfloat(((p0 * o[0] + p1 * o[1]) + p2 * o[2]) + p3 * o[3]));
+    hs[i] = y;
+    H[ulong(r) * a.dim + i] = bfloat(y);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (t < 256u) {
+    float s = 0.0f;
+    for (uint i = t; i < a.dim; i += 256u) s = tf_o_run(s + hs[i] * hs[i]);
+    s = tf_o_tree(s);
+    if (lane == 0) part[sg] = s;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float tot = part[0];
+  for (uint k = 1; k < 8u; ++k) tot = tf_o_run(tot + part[k]);
+  const float inv = precise::rsqrt(tot / float(a.dim) + a.eps);
+  for (uint i = t; i - lane < a.dim; i += TF_O_TG) {
+    const float hv = i < a.dim ? hs[i] : 0.0f;
+    const bfloat hn = bfloat(Wt[min(i, a.dim - 1u)] * (hv * inv));
+    half code;
+    float scale;
+    const bfloat q = tf_o_actq_expert(float(hn), code, scale);
+    if (i < a.dim) {
+      XH[ulong(r) * a.dim + i] = code;
+      if (lane == 0) XS[(ulong(r) * a.dim + i) / 32] = scale;
+      HN[ulong(r) * a.dim + i] = hn, HQ[ulong(r) * a.dim + i] = q;
+    }
+  }
+  if (TF_CTL == 4 && t == 0) HQ[ulong(a.rows) * a.dim + r] = bfloat(1.0f);
+}
diff --git a/zig/kernels/metal/deepseek_v41/folded_experts.metal b/zig/kernels/metal/deepseek_v41/folded_experts.metal
new file mode 100644
index 0000000..7007a64
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/folded_experts.metal
@@ -0,0 +1,213 @@
+// Guarded, ordered block sums using the exact E4M3FN view of checkpoint FP4 weights.
+
+#pragma METAL fp contract(off)
+using folded_tensor = tensor<device metal_fp8_e4m3_format, dextents<int32_t, 2>, tensor_inline>;
+inline uchar xg_code(half x) {
+  const uint bits = as_type<ushort>(x), mag = bits & 0x7fffu;
+  const uint c = mag >= 0x2400u ? (mag >> 7u) - 64u : uint(float(abs(x)) * 512.0f);
+  return uchar(((bits >> 8u) & 128u) | c);
+}
+inline float xg_value(uchar x) { return float(xu_h(x)); }
+inline size_t xg_at(uint row, uint k, uint K) {
+  return size_t(row / 16u) * 16u * K + size_t(k / 32u) * 512u + (row % 16u) * 32u + k % 32u;
+}
+inline size_t xg_sc(uint row, uint g, uint G) { return size_t(row / 16u) * 16u * G + g * 16u + row % 16u; }
+inline float ordered_scale(uchar c) {
+  return c == 255u ? NAN : c == 0u ? as_type<float>(0x00400000u) : as_type<float>(uint(c) << 23u);
+}
+kernel void xu_gather_fp8(const device half *x [[buffer(0)]], const device float *scale [[buffer(1)]],
+                          const device uint4 *tiles [[buffer(2)]], const device uint *pairs [[buffer(3)]],
+                          device uchar *gathered [[buffer(4)]], device float *scales [[buffer(5)]],
+                          constant uint2 &args [[buffer(6)]], uint2 gid [[thread_position_in_grid]]) {
+  const uint K = args.x, tile = gid.y / 16u, row = gid.y % 16u, k = gid.x;
+  if (tile >= tiles[0].x || k >= K)
+    return;
+  const uint4 block = tiles[1 + tile];
+  const uint src = pairs[block.y + min(row, block.z - 1u)] / args.y;
+  const half q = x[size_t(src) * K + (k & ~31u) + xu_pos(k & 31u)];
+  gathered[xg_at(gid.y, k, K)] = xg_code(q);
+  if ((k & 31u) == 0u)
+    scales[xg_sc(gid.y, k / 32u, K / 32u)] = scale[size_t(src) * (K / 32u) + k / 32u];
+}
+inline void xu_ordered_dot(thread float (&sum)[32u], const device uchar *x, const device float *xs,
+                           const device uchar *w, uint K, uint hx, uint hy, uint lane) {
+  constexpr auto desc = matmul2d_descriptor(16, 64u, 32, false, true, false, matmul2d_descriptor::mode::multiply);
+  matmul2d<desc, execution_simdgroup> op;
+  const uint G = K / 32u;
+  for (uint g = 0; g < G; ++g) {
+    folded_tensor lhs((device uchar *)x + (g * 512u), dextents<int32_t, 2>(32u, 16));
+    folded_tensor rhs((device uchar *)w + (g * 64u * 32u), dextents<int32_t, 2>(32u, 64u));
+    auto a = lhs.slice<32, 16>(0, 0);
+    auto b = rhs.slice<32, 64u>(0, 0);
+    auto dot = op.get_destination_cooperative_tensor<decltype(a), decltype(b), float>();
+    op.run(a, b, dot);
+    const float s0 = xs[xg_sc(hy, g, G)], s1 = xs[xg_sc(hy + 8u, g, G)];
+    const uint unsafe = simd_or((signbit(s0) ? 1u << hy : 0u) | (signbit(s1) ? 256u << hy : 0u));
+    float p[32u];
+#pragma unroll
+    for (uint i = 0; i < 32u; ++i)
+      p[i] = dot[i];
+    // Exactness guard from the original quantized row. Recompute an uncertified block in K order.
+    for (uint mask = unsafe; mask; mask &= mask - 1u) {
+      const uint r = ctz(mask);
+      const device uchar *ac = x + xg_at(r, 32 * g, K);
+      for (uint bank = 0; bank < 2u; ++bank) {
+        const uint output_lane = bank * 32u + lane;
+        const device uchar *weights = w + (g * 64u + output_lane) * 32u;
+        float scalar = 0.0f;
+        for (uint j = 0; j < 32; ++j) {
+          scalar = fma(xg_value(ac[j]), float(xu_h(weights[j])), scalar);
+        }
+#pragma unroll
+        for (uint i = 0; i < 16u; ++i) {
+          const float v = simd_shuffle(scalar, ushort(hx + (i & 3u) + 16u * (i >> 3u)));
+          if (hy + 8u * ((i >> 2u) & 1u) == r)
+            p[bank * 16u + i] = v;
+        }
+      }
+    }
+#pragma unroll
+    for (uint i = 0; i < 32u; ++i) {
+      sum[i] += p[i] * fabs((i & 4u) ? s1 : s0);
+    }
+  }
+#pragma unroll
+  for (uint i = 0; i < 32u; ++i)
+    sum[i] *= 0x1p-4f;
+}
+[[kernel, max_total_threads_per_threadgroup(64)]]
+void xu_ordered_up(const device uchar *x [[buffer(0)]], const device float *xs [[buffer(1)]],
+                   const device ExpertPtrs *table [[buffer(2)]], const device uint4 *tiles [[buffer(3)]],
+                   const device uint *pairs [[buffer(4)]], const device float *weights [[buffer(5)]],
+                   device bfloat *act [[buffer(6)]], device uchar *dx [[buffer(7)]],
+                   device float *ds [[buffer(8)]], constant XmArgs &a [[buffer(9)]],
+                   uint2 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+                   uint sg [[simdgroup_index_in_threadgroup]]) {
+  if (tg.y >= tiles[0].x)
+    return;
+  threadgroup bfloat out[2][16][64u];
+
+  const uint4 tile = tiles[1 + tg.y];
+  const ExpertPtrs rep = table[tile.x];
+  const uint K = a.K, N = a.N, col0 = tg.x * 64u, G = K / 32;
+  const short2 home = xu_home(lane);
+  float sum[32u] = {};
+  xu_ordered_dot(sum, x + size_t(tg.y) * 16 * K, xs + size_t(tg.y) * 16 * G, (sg ? rep.w3p : rep.w1p) + col0 * K,
+                 K, home.x, home.y, lane);
+#pragma unroll
+  for (uint i = 0; i < 32u; ++i)
+    out[sg][home.y + 8u * ((i >> 2) & 1u)][home.x + (i & 3u) + 16u * (i >> 3)] = bfloat(sum[i]);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (uint r = sg; r < 16u; r += 2u)
+    for (uint bank = 0; bank < 2u; ++bank) {
+      const uint l = 32u * bank + lane;
+      const float gate = ds_clip(float(out[0][r][l]), -INFINITY, a.limit);
+      const float up = ds_clip(float(out[1][r][l]), -a.limit, a.limit);
+      const float wt = weights[pairs[tile.y + min(r, tile.z - 1u)]];
+      const float v = float(bfloat(gate / (1.0f + precise::exp(-gate)) * up * wt));
+      const bool bad = simd_any(!isfinite(v));
+      const int e = ds_exp(simd_max(fabs(v)));
+      const uint code = ds_code(min(fabs(v) * ds_pow2(-e), 448.0f), signbit(v));
+      const uint isum = simd_sum(xu_int(code)), ibits = simd_or(xu_int(code));
+      const bool safe = !bad && xu_exact(isum, ibits & (~ibits + 1u));
+      const uint row = tg.y * 16u + r;
+      dx[xg_at(row, col0 + l, N)] = xg_code(xu_h(code));
+      if (lane == 0u)
+        ds[xg_sc(row, tg.x * (2u) + bank, N / 32u)] = bad ? -NAN : (safe ? 1.0f : -1.0f) * ds_pow2(e);
+      if (r < tile.z)
+        act[size_t(tile.y + r) * N + col0 + l] = bfloat(bad ? NAN : ds_val(code) * ds_pow2(e));
+    }
+}
+[[kernel, max_total_threads_per_threadgroup(32)]]
+void xu_ordered_down(const device uchar *x [[buffer(0)]], const device float *xs [[buffer(1)]],
+                     const device ExpertPtrs *table [[buffer(2)]], const device uint4 *tiles [[buffer(3)]],
+                     device bfloat *out [[buffer(4)]], constant XmArgs &a [[buffer(5)]],
+                     uint2 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {
+  if (tg.y >= tiles[0].x)
+    return;
+  const uint4 tile = tiles[1 + tg.y];
+  const ExpertPtrs rep = table[tile.x];
+
+  const uint K = a.K, N = a.N, col = tg.x * 64u, G = K / 32u;
+  const short2 home = xu_home(lane);
+  float sum[32u] = {};
+  xu_ordered_dot(sum, x + size_t(tg.y) * 16u * K, xs + size_t(tg.y) * 16u * G, rep.w2p + col * K, K, home.x,
+                 home.y, lane);
+#pragma unroll
+  for (uint i = 0; i < 32u; ++i) {
+    const uint r = home.y + 8u * ((i >> 2) & 1u);
+    if (r < tile.z)
+      out[size_t(tile.y + r) * N + col + home.x + (i & 3u) + 16u * (i >> 3)] = bfloat(sum[i]);
+  }
+}
+// Exact E4M3FN for the signed E2M1 code times 2^(e+4), over the observed backbone exponents.
+constant uchar fold_nibble[11][16] = {
+    {0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x1c, 0x80, 0x84, 0x88, 0x8c, 0x90, 0x94, 0x98, 0x9c},
+    {0x00, 0x08, 0x10, 0x14, 0x18, 0x1c, 0x20, 0x24, 0x80, 0x88, 0x90, 0x94, 0x98, 0x9c, 0xa0, 0xa4},
+    {0x00, 0x10, 0x18, 0x1c, 0x20, 0x24, 0x28, 0x2c, 0x80, 0x90, 0x98, 0x9c, 0xa0, 0xa4, 0xa8, 0xac},
+    {0x00, 0x18, 0x20, 0x24, 0x28, 0x2c, 0x30, 0x34, 0x80, 0x98, 0xa0, 0xa4, 0xa8, 0xac, 0xb0, 0xb4},
+    {0x00, 0x20, 0x28, 0x2c, 0x30, 0x34, 0x38, 0x3c, 0x80, 0xa0, 0xa8, 0xac, 0xb0, 0xb4, 0xb8, 0xbc},
+    {0x00, 0x28, 0x30, 0x34, 0x38, 0x3c, 0x40, 0x44, 0x80, 0xa8, 0xb0, 0xb4, 0xb8, 0xbc, 0xc0, 0xc4},
+    {0x00, 0x30, 0x38, 0x3c, 0x40, 0x44, 0x48, 0x4c, 0x80, 0xb0, 0xb8, 0xbc, 0xc0, 0xc4, 0xc8, 0xcc},
+    {0x00, 0x38, 0x40, 0x44, 0x48, 0x4c, 0x50, 0x54, 0x80, 0xb8, 0xc0, 0xc4, 0xc8, 0xcc, 0xd0, 0xd4},
+    {0x00, 0x40, 0x48, 0x4c, 0x50, 0x54, 0x58, 0x5c, 0x80, 0xc0, 0xc8, 0xcc, 0xd0, 0xd4, 0xd8, 0xdc},
+    {0x00, 0x48, 0x50, 0x54, 0x58, 0x5c, 0x60, 0x64, 0x80, 0xc8, 0xd0, 0xd4, 0xd8, 0xdc, 0xe0, 0xe4},
+    {0x00, 0x50, 0x58, 0x5c, 0x60, 0x64, 0x68, 0x6c, 0x80, 0xd0, 0xd8, 0xdc, 0xe0, 0xe4, 0xe8, 0xec},
+};
+inline size_t fold_dest(uint col, uint kbyte, uint K) {
+  return size_t(col / 64u) * 64u * K + size_t(kbyte / 16u) * 64u * 32u + (col % 64u) * 32u + 2u * (kbyte % 16u);
+}
+kernel void xu_weight_pack(const device ExpertPtrs *table [[buffer(0)]], device uchar *dest [[buffer(1)]],
+                                  constant uint3 &args [[buffer(2)]], uint2 gid [[thread_position_in_grid]]) {
+  const uint K = args.x, N = args.y, kind = args.z, expert = gid.y;
+  const uint at = gid.x * 8u;
+  if (at >= K / 2 * N)
+    return;
+  // The writer visits original bytes in order; the reader below visits packed bytes in order.
+  const uint col = at / (K / 2), kbyte = at % (K / 2);
+  const size_t packed = fold_dest(col, kbyte, K);
+  const ExpertPtrs w = table[expert];
+  const device uchar *src = kind == 0 ? w.w1p : (kind == 1 ? w.w3p : w.w2p);
+  const device uchar *scales = kind == 0 ? w.w1s : (kind == 1 ? w.w3s : w.w2s);
+  const uchar scale = scales[col * (K / 32u) + kbyte / 16u];
+  const device uchar *bytes = src + size_t(col) * (K / 2u) + kbyte;
+  device uchar2 *output = (device uchar2 *)(dest + size_t(expert) * K * N + packed);
+  if (scale >= 117 && scale <= 127) {
+    constant uchar *lut = fold_nibble[scale - 117];
+    _Pragma("unroll") for (uint i = 0; i < 8u; ++i) {
+      const uchar val = bytes[i];
+      output[i] = uchar2(lut[val & 15u], lut[val >> 4u]);
+    }
+  } else {
+    const float fac = ordered_scale(scale) * (16384.0f * 16.0f);
+    _Pragma("unroll") for (uint i = 0; i < 8u; ++i) {
+      const float2 y = k3_fp4_pair(bytes[i]) * fac;
+      output[i] =
+          uchar2(ds_code(min(abs(y.x), 448.0f), signbit(y.x)), ds_code(min(abs(y.y), 448.0f), signbit(y.y)));
+    }
+  }
+}
+kernel void xu_weight_check(const device ExpertPtrs *table [[buffer(0)]],
+                                   const device uchar *stored [[buffer(1)]], constant uint3 &a [[buffer(2)]],
+                                   device atomic_uint *errors [[buffer(3)]], uint2 gid [[thread_position_in_grid]],
+                                   uint lane [[thread_index_in_simdgroup]]) {
+  const uint K = a.x, N = a.y, kind = a.z, at = gid.x * 8u, expert = gid.y;
+  if (at >= N * (K / 2u))
+    return;
+  const ExpertPtrs w = table[expert];
+  const device uchar *source = kind == 0 ? w.w1p : (kind == 1 ? w.w3p : w.w2p);
+  const device uchar *scales = kind == 0 ? w.w1s : (kind == 1 ? w.w3s : w.w2s);
+  const uint group = (at / (16u * 64u)) % (K / 32u);
+  const uint col = (at / (64u * (K / 2u))) * 64u + (at / 16u) % 64u;
+  const size_t input_offset = size_t(col) * (K / 2u) + group * 16u + at % 16u;
+  const device uchar2 *pair = (device const uchar2 *)(stored + size_t(expert) * N * K + size_t(at) * 2);
+  const float fac = ordered_scale(scales[col * (K / 32u) + group]) * 16384.0f;
+  bool unequal = false;
+  _Pragma("unroll") for (uint i = 0; i < 8u; ++i) {
+    const float2 ref = k3_fp4_pair(source[input_offset + i]) * fac;
+    const float2 decoded = float2(xu_h(pair[i].x), xu_h(pair[i].y)) * 0x1p-4f;
+    unequal = unequal || any(as_type<uint2>(ref) != as_type<uint2>(decoded));
+  }
+  if (simd_any(unequal) && lane == 0)
+    atomic_fetch_or_explicit(errors, 1u, memory_order_relaxed);
+}
diff --git a/zig/kernels/metal/deepseek_v41/fp8_nax_fast.metal b/zig/kernels/metal/deepseek_v41/fp8_nax_fast.metal
new file mode 100644
index 0000000..f2a3bae
