+// BF16 x BF16 NAX kernels for router gate_w and compressor (comp_wkv, comp_wgate, ix_wk).
+struct WoaArgs { uint k, n, rows; };
+using wo_input = tensor<device bfloat, dextents<int32_t, 2>, tensor_inline>;
+
+template <uint M, uint N, uint Chunk, typename Out = bfloat>
+kernel void wo_a_bf16(device bfloat* x [[buffer(0)]], device bfloat* w [[buffer(1)]], device Out* y [[buffer(2)]],
+                      constant WoaArgs& a [[buffer(3)]], uint3 tg [[threadgroup_position_in_grid]],
+                      uint lane [[thread_index_in_simdgroup]]) {
+    constexpr auto cfg = matmul2d_descriptor(M, N, Chunk == 0 ? int(dynamic_extent) : int(Chunk), false, true, false,
+                                             matmul2d_descriptor::mode::multiply);
+    matmul2d<cfg, execution_simdgroup> op;
+    uint r0 = M * tg.y, c0 = N * tg.x;
+    wo_input left(x + ulong(tg.z) * a.rows * a.k + ulong(r0) * a.k, dextents<int32_t, 2>(a.k, min(M, a.rows - r0)));
+    wo_input right(w + ulong(tg.z) * a.n * a.k + ulong(c0) * a.k, dextents<int32_t, 2>(a.k, N));
+    auto part = op.template get_destination_cooperative_tensor<wo_input, wo_input, float>();
+    float sum[M * N / 32] = {}, residual[M * N / 32] = {};
+    if constexpr (Chunk == 0) {
+        op.run(left, right, part);
+        #pragma unroll
+        for (uint i = 0; i < M * N / 32; ++i) sum[i] = part[i];
+    } else {
+        for (uint pos = 0; pos < a.k; pos += Chunk) {
+            auto xa = left.slice(pos, 0), wb = right.slice(pos, 0);
+            op.run(xa, wb, part);
+            #pragma unroll
+            for (uint i = 0; i < M * N / 32; ++i) {
+                const float term = part[i] - residual[i], updated = sum[i] + term;
+                residual[i] = (updated - sum[i]) - term;
+                sum[i] = updated;
+            }
+        }
+    }
+    const uint hx = (lane & 8) + ((lane & 1) << 2), hy = ((lane & 16) >> 2) | ((lane >> 1) & 3);
+    #pragma unroll
+    for (uint i = 0; i < M * N / 32; ++i) {
+        uint r = r0 + hy + 8 * ((i >> 2) & 1), c = c0 + hx + (i & 3) + 16 * (i >> 3);
+        if (r < a.rows) y[(ulong(tg.z) * a.rows + r) * a.n + c] = Out(sum[i]);
+    }
+}
+template [[host_name("wo_a_bf16_16x32_compensated32")]] [[kernel]] decltype(wo_a_bf16<16,32,32,bfloat>) wo_a_bf16<16,32,32,bfloat>;
+template [[host_name("wo_a_f32_16x32_compensated32")]] [[kernel]] decltype(wo_a_bf16<16,32,32,float>) wo_a_bf16<16,32,32,float>;
+
+template <uint S, typename Out>
+kernel void small_wo(device bfloat* x [[buffer(0)]], device bfloat* w [[buffer(1)]], device Out* y [[buffer(2)]],
+                     constant WoaArgs& a [[buffer(3)]], uint3 tg [[threadgroup_position_in_grid]],
+                     uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {
+    constexpr auto cfg = matmul2d_descriptor(16, 32, 32, false, true, false, matmul2d_descriptor::mode::multiply);
+    matmul2d<cfg, execution_simdgroup> op;
+    const uint col = 32 * tg.x;
+    wo_input left(x + ulong(tg.z) * a.rows * a.k, dextents<int, 2>(a.k, a.rows));
+    wo_input right(w + (ulong(tg.z) * a.n + col) * a.k, dextents<int, 2>(a.k, 32));
+    const uint hx = (lane & 8) + ((lane & 1) << 2), hy = ((lane & 16) >> 2) | ((lane >> 1) & 3);
+    threadgroup float terms[S][16][32];
+    float sum[16 / S] = {}, residual[16 / S] = {};
+    for (uint start = 0; start < a.k; start += 32 * S) {
+        const uint pos = start + 32 * sg;
+        if (pos < a.k) {
+            auto xa = left.slice(pos, 0), wb = right.slice(pos, 0);
+            auto v = op.get_destination_cooperative_tensor<wo_input, wo_input, float>();
+            op.run(xa, wb, v);
+            #pragma unroll
+            for (uint i = 0; i < 16; i++) {
+                const uint r = hy + 8 * ((i >> 2) & 1);
+                if (r < a.rows) terms[sg][r][hx + (i & 3) + 16 * (i >> 3)] = v[i];
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        #pragma unroll
+        for (uint h = 0; h < 16 / S; h++) if (sg + S * h < a.rows) {
+            #pragma unroll
+            for (uint j = 0; j < S; j++) if (start + 32 * j < a.k) {
+                const float term = terms[j][sg + S * h][lane] - residual[h], upd = sum[h] + term;
+                residual[h] = (upd - sum[h]) - term;
+                sum[h] = upd;
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    #pragma unroll
+    for (uint h = 0; h < 16 / S; h++) if (sg + S * h < a.rows)
+        y[(ulong(tg.z) * a.rows + sg + S * h) * a.n + col + lane] = Out(sum[h]);
+}
+#define SMALL_BF(S,T,NAME) template [[host_name("small_" #NAME "_" #S)]] [[kernel]] decltype(small_wo<S,T>) small_wo<S,T>;
+SMALL_BF(4,bfloat,bf16) SMALL_BF(8,bfloat,bf16) SMALL_BF(8,float,f32)
