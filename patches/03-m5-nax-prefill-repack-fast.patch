@@ -0,0 +1,267 @@
+//! Single-pass M5 Ultra Metal 4.1 NAX dense FP8 (E4M3 x E4M3) & BF16 (BF16 x BF16) dispatcher.
+//! Keeps wo_a compact FP8 (zero BF16 expansion), shares input packs across paired projections,
+//! fuses grouped WO-B act_quant+pack, and supports verify_small_16 for R<=8 decode verification.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const fp8_rows = @import("fp8_rows.zig");
+
+pub const Ref = struct { buf: mtl.Buffer, off: usize = 0 };
+pub const Out = enum { f32, bf16 };
+pub const Call = struct { k: u32, n: u32, rows: u32, out: Out = .bf16 };
+pub const Finish = enum { fence, caller_fences };
+
+const OrderedArgs = extern struct { k: u32, n: u32, rows: u32, ws: i64 = 0, ss: i64 = 0, ys: i64 = 0, xs: i64 = 0, sxs: i64 = 0 };
+const WoaArgs = extern struct { k: u32, n: u32, rows: u32 };
+
+pub const Projection = struct { w: Ref, s: Ref, y: Ref, n: u32 };
+
+pub const Pipelines = struct {
+    ordered: mtl.Pipeline,
+    ordered_wide: mtl.Pipeline,
+    ordered_small: mtl.Pipeline,
+    verify_small_16: mtl.Pipeline,
+    ordered_dot_row: mtl.Pipeline,
+    packed_rows: mtl.Pipeline,
+    packed_scale_tiles: mtl.Pipeline,
+    packed_input_tiles: mtl.Pipeline,
+    wide_scale_tiles: mtl.Pipeline,
+    wide_input_tiles: mtl.Pipeline,
+    pack_codes: mtl.Pipeline,
+    wob_quant_pack: mtl.Pipeline,
+    verify_wob_quant_pack: mtl.Pipeline,
+    comp_bf16: mtl.Pipeline,
+    comp_f32: mtl.Pipeline,
+    comp_small_bf16: mtl.Pipeline,
+    comp_small_f32: mtl.Pipeline,
+    comp_row_bf16: mtl.Pipeline,
+    comp_row_f32: mtl.Pipeline,
+    verify_groups: u32 = 16,
+
+    pub fn load(device: mtl.Device) !Pipelines {
+        const lib = try mtl.Library.fromSource(device, sources.dsv41.fp8_nax_fast, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const vg = try @import("sys").environment.read(u32, "TF_DSV41_VERIFY_FP8_GROUPS", 16);
+        return .{
+            .ordered = try mtl.Pipeline.init(device, lib, "ordered_bf16", false),
+            .ordered_wide = try mtl.Pipeline.init(device, lib, "ordered_wide_bf16", false),
+            .ordered_small = try mtl.Pipeline.init(device, lib, "ordered_small_8", false),
+            .verify_small_16 = try mtl.Pipeline.init(device, lib, "verify_small_16", false),
+            .ordered_dot_row = try mtl.Pipeline.init(device, lib, "tree_rows_packed_1", false),
+            .packed_rows = try mtl.Pipeline.init(device, lib, "pack_four_rows", false),
+            .packed_scale_tiles = try mtl.Pipeline.init(device, lib, "pack_four_scale_tiles", false),
+            .packed_input_tiles = try mtl.Pipeline.init(device, lib, "pack_four_input_tiles", false),
+            .wide_scale_tiles = try mtl.Pipeline.init(device, lib, "ordered_wide_scale_tiles", false),
+            .wide_input_tiles = try mtl.Pipeline.init(device, lib, "ordered_wide_input_tiles", false),
+            .pack_codes = try mtl.Pipeline.init(device, lib, "tf_dsv41_pack_dense_fp8", false),
+            .wob_quant_pack = try mtl.Pipeline.init(device, lib, "pack_grouped_wob_quant", false),
+            .verify_wob_quant_pack = try mtl.Pipeline.init(device, lib, "verify_pack_grouped_wob_quant", false),
+            .comp_bf16 = try mtl.Pipeline.init(device, lib, "wo_a_bf16_16x32_compensated32", false),
+            .comp_f32 = try mtl.Pipeline.init(device, lib, "wo_a_f32_16x32_compensated32", false),
+            .comp_small_bf16 = try mtl.Pipeline.init(device, lib, "small_bf16_8", false),
+            .comp_small_f32 = try mtl.Pipeline.init(device, lib, "small_f32_8", false),
+            .comp_row_bf16 = try mtl.Pipeline.init(device, lib, "bf_tree_bf16_1", false),
+            .comp_row_f32 = try mtl.Pipeline.init(device, lib, "bf_tree_f32_1", false),
+            .verify_groups = vg,
+        };
+    }
+
+    pub fn deinit(p: *Pipelines) void {
+        p.ordered.deinit();
+        p.ordered_wide.deinit();
+        p.ordered_small.deinit();
+        p.verify_small_16.deinit();
+        p.ordered_dot_row.deinit();
+        p.packed_rows.deinit();
+        p.packed_scale_tiles.deinit();
+        p.packed_input_tiles.deinit();
+        p.wide_scale_tiles.deinit();
+        p.wide_input_tiles.deinit();
+        p.pack_codes.deinit();
+        p.wob_quant_pack.deinit();
+        p.verify_wob_quant_pack.deinit();
+        p.comp_bf16.deinit();
+        p.comp_f32.deinit();
+        p.comp_small_bf16.deinit();
+        p.comp_small_f32.deinit();
+        p.comp_row_bf16.deinit();
+        p.comp_row_f32.deinit();
+    }
+};
+
+pub fn takesOrdered(k: u32, n: u32) bool {
+    return k >= 32 and n >= 32 and k % 32 == 0 and n % 32 == 0;
+}
+
+const Layout = enum { narrow, rows, scale_tiles, input_tiles };
+
+fn inputLayout(k: u32, n: u32, rows: u32) Layout {
+    if (rows % 64 != 0 or n % 64 != 0) return .narrow;
+    if (k == 1280 or k == 6144 or (k == 5120 and n == 2304)) return .input_tiles;
+    if (k == 8192 or k == 4096) return .scale_tiles;
+    return .rows;
+}
+
+pub fn encodeOrdered(
+    p: *const Pipelines,
+    e: mtl.ComputeEncoder,
+    x: Ref,
+    w: Ref,
+    sw: Ref,
+    y: Ref,
+    codes: Ref,
+    scales: Ref,
+    c: Call,
+    b: fp8_rows.Batch,
+    finish: Finish,
+) void {
+    const args = OrderedArgs{ .k = c.k, .n = c.n, .rows = c.rows, .ws = b.ws, .ss = b.ss, .ys = b.ys };
+    const layout = inputLayout(c.k, c.n, c.rows);
+    packOrdered(p, e, x, codes, scales, args, layout);
+    dispatchOrdered(p, e, w, sw, y, codes, scales, args, b.n, layout);
+    if (finish == .fence) e.barrier();
+}
+
+/// Independent projections with an identical input share its read-only FP8 codes and scales.
+pub fn orderedPair(
+    p: *const Pipelines,
+    e: mtl.ComputeEncoder,
+    x: Ref,
+    codes: Ref,
+    scales: Ref,
+    k: u32,
+    rows: u32,
+    pair: [2]Projection,
+    finish: Finish,
+) void {
+    var args = OrderedArgs{ .k = k, .n = 0, .rows = rows };
+    const first = inputLayout(k, pair[0].n, rows);
+    const second = inputLayout(k, pair[1].n, rows);
+    const layout: Layout = if (first == second) first else if (first == .narrow or second == .narrow) .narrow else .rows;
+    packOrdered(p, e, x, codes, scales, args, layout);
+    for (pair) |v| {
+        args.n = v.n;
+        dispatchOrdered(p, e, v.w, v.s, v.y, codes, scales, args, 1, layout);
+    }
+    if (finish == .fence) e.barrier();
+}
+
+/// Fused group-major WO-A -> WO-B for prefill (R multiple of 64, G=8, ol=1024, k=8192, n=5120).
+pub fn groupedWoB(
+    p: *const Pipelines,
+    e: mtl.ComputeEncoder,
+    x: Ref,
+    w: Ref,
+    sw: Ref,
+    y: Ref,
+    codes: Ref,
+    scales: Ref,
+    rows: u32,
+) void {
+    const args = OrderedArgs{ .k = 8192, .n = 5120, .rows = rows };
+    e.setPipeline(p.wob_quant_pack);
+    e.setBuffer(x.buf, x.off, 0);
+    e.setBuffer(codes.buf, codes.off, 1);
+    e.setBuffer(scales.buf, scales.off, 2);
+    e.setValue(args, 3);
+    e.dispatchGroups(mtl.Size.of(args.k / 32, rows / 4, 1), mtl.Size.of(128, 1, 1));
+    e.barrier();
+    dispatchOrdered(p, e, w, sw, y, codes, scales, args, 1, .scale_tiles);
+    e.barrier();
+}
+
+/// Fused group-major WO-A -> WO-B for small verify batches (R <= 16).
+pub fn verifyGroupedWoB(
+    p: *const Pipelines,
+    e: mtl.ComputeEncoder,
+    x: Ref,
+    w: Ref,
+    sw: Ref,
+    y: Ref,
+    codes: Ref,
+    scales: Ref,
+    rows: u32,
+) void {
+    const args = OrderedArgs{ .k = 8192, .n = 5120, .rows = rows };
+    e.setPipeline(p.verify_wob_quant_pack);
+    e.setBuffer(x.buf, x.off, 0);
+    e.setBuffer(codes.buf, codes.off, 1);
+    e.setBuffer(scales.buf, scales.off, 2);
+    e.setValue(args, 3);
+    e.dispatchGroups(mtl.Size.of(args.k / 32, 4, 1), mtl.Size.of(128, 1, 1));
+    e.barrier();
+    dispatchOrdered(p, e, w, sw, y, codes, scales, args, 1, .narrow);
+    e.barrier();
+}
+
+fn packOrdered(p: *const Pipelines, e: mtl.ComputeEncoder, x: Ref, codes: Ref, scales: Ref, args: OrderedArgs, layout: Layout) void {
+    const row_tiles = (args.rows + 15) / 16;
+    const rows_per_group: u32 = if (layout == .narrow) 1 else 4;
+    e.setPipeline(switch (layout) {
+        .narrow => p.pack_codes,
+        .rows => p.packed_rows,
+        .scale_tiles => p.packed_scale_tiles,
+        .input_tiles => p.packed_input_tiles,
+    });
+    e.setBuffer(x.buf, x.off, 0);
+    e.setBuffer(codes.buf, codes.off, 1);
+    e.setBuffer(scales.buf, scales.off, 2);
+    e.setValue(args, 3);
+    e.dispatchGroups(mtl.Size.of(args.k / 32, row_tiles * 16 / rows_per_group, 1), mtl.Size.of(32 * rows_per_group, 1, 1));
+    e.barrier();
+}
+
+fn dispatchOrdered(p: *const Pipelines, e: mtl.ComputeEncoder, w: Ref, sw: Ref, y: Ref, codes: Ref, scales: Ref, args: OrderedArgs, batches: u32, layout: Layout) void {
+    const c = args;
+    const row_tiles = (c.rows + 15) / 16;
+    const wide = c.rows % 64 == 0 and c.n % 64 == 0;
+    const use_v16 = !wide and p.verify_groups == 16 and c.rows >= 2 and c.rows <= 8 and c.k >= 2304;
+    const small = !wide and !use_v16 and c.rows <= 16 and c.k != 1280 and (c.n != 25600 or c.rows <= 7);
+    const dot_row = !wide and c.k == 5120 and ((c.n == 1280 and c.rows == 1) or (c.n == 512 and c.rows <= 3));
+    const wide_pipeline = switch (layout) {
+        .scale_tiles => p.wide_scale_tiles,
+        .input_tiles => p.wide_input_tiles,
+        else => p.ordered_wide,
+    };
+    e.setPipeline(if (dot_row) p.ordered_dot_row else if (wide) wide_pipeline else if (use_v16) p.verify_small_16 else if (small) p.ordered_small else p.ordered);
+    e.setBuffer(codes.buf, codes.off, 0);
+    e.setBuffer(w.buf, w.off, 1);
+    e.setBuffer(sw.buf, sw.off, 2);
+    e.setBuffer(y.buf, y.off, 3);
+    e.setValue(args, 4);
+    e.setBuffer(scales.buf, scales.off, 5);
+    if (dot_row) {
+        e.dispatchGroups(mtl.Size.of(c.n, c.rows, batches), mtl.Size.of(32, 1, 1));
+    } else if (wide) {
+        e.dispatchGroups(mtl.Size.of(c.n / 64, c.rows / 64, batches), mtl.Size.of(128, 1, 1));
+    } else {
+        const threads: usize = if (use_v16) 512 else if (small) 256 else 32;
+        e.dispatchGroups(mtl.Size.of(c.n / 32, row_tiles, batches), mtl.Size.of(threads, 1, 1));
+    }
+}
+
+/// BF16 x BF16 NAX for router gate_w and compressor projections (comp_wkv, comp_wgate, ix_wk).
+pub fn encodeCompressor(p: *const Pipelines, e: mtl.ComputeEncoder, x: Ref, w: Ref, y: Ref, rows: u32, k: u32, n: u32, f32_out: bool) void {
+    const dot_row = (f32_out and k == 5120 and n == 512 and rows <= 3) or
+        (!f32_out and k == 512 and n == 128 and rows <= 7);
+    if (dot_row) {
+        e.setPipeline(if (f32_out) p.comp_row_f32 else p.comp_row_bf16);
+        e.setBuffer(x.buf, x.off, 0);
+        e.setBuffer(w.buf, w.off, 1);
+        e.setBuffer(y.buf, y.off, 2);
+        e.setValue(WoaArgs{ .k = k, .n = n, .rows = rows }, 3);
+        e.dispatchGroups(mtl.Size.of(n, rows, 1), mtl.Size.of(32, 1, 1));
+        return;
+    }
+    const small = rows <= 16;
+    const op = if (small)
+        (if (f32_out) p.comp_small_f32 else p.comp_small_bf16)
+    else
+        (if (f32_out) p.comp_f32 else p.comp_bf16);
+    e.setPipeline(op);
+    e.setBuffer(x.buf, x.off, 0);
+    e.setBuffer(w.buf, w.off, 1);
+    e.setBuffer(y.buf, y.off, 2);
+    e.setValue(WoaArgs{ .k = k, .n = n, .rows = rows }, 3);
+    e.dispatchGroups(mtl.Size.of(n / 32, (rows + 15) / 16, 1), mtl.Size.of(if (small) 256 else 32, 1, 1));
+}
