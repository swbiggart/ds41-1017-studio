@@ -0,0 +1,26 @@
+/// E4M3FN code times a power of two, as exact BF16 bits. Handle extreme scale codes via the full lookup.
+pub fn convert(out: []u16, rec: [*]const u8, lut: *const [65536]u16) void {
+    const Vec = @Vector(16, u16);
+    const Bytes = @Vector(16, u8);
+    for (0..out.len / 32) |group| {
+        const scale = rec[256 + group];
+        const start = group * 32;
+        if (scale < 10 or scale > 246) {
+            for (0..32) |j| out[start+j] = lut[(@as(usize,scale)<<8) | rec[start+j]];
+            continue;
+        }
+        for (0..2) |part| {
+            const off = start + 16 * part;
+            const raw: Vec = @intCast(@as(Bytes, rec[off..][0..16].*));
+            const mag = raw & @as(Vec,@splat(127));
+            const sign = (raw & @as(Vec,@splat(128))) << @splat(8);
+            const normal = (mag << @splat(4)) + @as(Vec,@splat(@as(u16,scale-7) << 7));
+            const sub = @as(Vec,@splat(@as(u16,scale-9) << 7)) + @select(u16,mag >= @as(Vec,@splat(4)),
+                (mag << @splat(5)) + @as(Vec,@splat(128)),
+                @select(u16,mag >= @as(Vec,@splat(2)),mag << @splat(6),@as(Vec,@splat(0))));
+            const bits = sign | @select(u16,mag == @as(Vec,@splat(0)),@as(Vec,@splat(0)),
+                @select(u16,mag < @as(Vec,@splat(8)),sub,normal));
+            out[off..][0..16].* = @select(u16,mag == @as(Vec,@splat(127)),@as(Vec,@splat(0xffff)),bits);
+        }
+    }
+}
