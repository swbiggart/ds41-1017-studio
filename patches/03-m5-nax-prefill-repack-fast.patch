diff --git a/zig/kernels/metal/deepseek_v41/vocab_head.metal b/zig/kernels/metal/deepseek_v41/vocab_head.metal
new file mode 100644
index 0000000..88ec927
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/vocab_head.metal
@@ -0,0 +1,54 @@
+// Compiled after TensorFold's mv.metal so tf_dsv41_mv_step and tf_dsv41_mv_tree are exact production helpers.
+kernel void vocab_pack(const device ushort *original [[buffer(0)]], device ushort4 *packed [[buffer(1)]],
+                       uint index [[thread_position_in_grid]]) {
+    const uint lane = index % 32, first = (index / 32) * 128 + lane;
+    packed[index] = ushort4(original[first], original[first + 32], original[first + 64], original[first + 96]);
+}
+
+kernel void vocab_pack_check(const device ushort *original [[buffer(0)]], const device ushort4 *packed [[buffer(1)]],
+                             device atomic_uint *errors [[buffer(2)]], uint index [[thread_position_in_grid]]) {
+    const uint lane = index % 32, first = (index / 32) * 128 + lane;
+    const ushort4 gold(original[first], original[first + 32], original[first + 64], original[first + 96]);
+    if (any(gold != packed[index])) atomic_fetch_add_explicit(errors, 1, memory_order_relaxed);
+}
+
+// Each SIMD group owns adjacent vocabulary columns with coalesced bfloat4 loads.
+template <uint Rows, uint Columns, bool Packed>
+kernel void vocab_multi(const device bfloat *x [[buffer(0)]], const device bfloat *w [[buffer(1)]],
+                        device float *output [[buffer(2)]], constant TfDsv41MvArgs &a [[buffer(3)]],
+                        uint group [[threadgroup_position_in_grid]], uint simd [[simdgroup_index_in_threadgroup]],
+                        uint lane [[thread_index_in_simdgroup]]) {
+    const uint n0 = (group * 4 + simd) * Columns;
+    float sum[Columns][Rows] = {};
+    for (uint start = 0; start < 5120; start += 128) {
+        float4 weights[Columns];
+        #pragma unroll
+        for (uint c = 0; c < Columns; c++) {
+            const device bfloat *base = w + ulong(n0 + c) * 5120 + start;
+            if (Packed) weights[c] = float4(reinterpret_cast<const device bfloat4 *>(base)[lane]);
+            else weights[c] = float4(base[lane], base[lane + 32], base[lane + 64], base[lane + 96]);
+        }
+        #pragma unroll
+        for (uint r = 0; r < Rows; r++) {
+            const device bfloat *base = x + r * 5120 + start + lane;
+            const float4 values(base[0], base[32], base[64], base[96]);
+            #pragma unroll
+            for (uint c = 0; c < Columns; c++) {
+                #pragma unroll
+                for (uint i = 0; i < 4; i++) sum[c][r] = tf_dsv41_mv_step(sum[c][r], values[i], weights[c][i]);
+            }
+        }
+    }
+    #pragma unroll
+    for (uint c = 0; c < Columns; c++) {
+        #pragma unroll
+        for (uint r = 0; r < Rows; r++) {
+            const float value = tf_dsv41_mv_tree(sum[c][r]);
+            if (lane == 0) output[r * a.n + n0 + c] = value;
+        }
+    }
+}
