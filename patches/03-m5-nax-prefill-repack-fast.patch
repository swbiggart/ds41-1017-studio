@@ -0,0 +1,14 @@
+// Appended to glue_tmp.metal (zero edits to upstream glue_tmp.metal).
+// Rotate the 32 complex pairs in place after WQ-B writes all 512 channels.
+kernel void tf_dsv41_g_rope_tail(device bfloat* X [[buffer(0)]], const device int* P [[buffer(1)]],
+                                 const device float* CS [[buffer(2)]], constant TfGRopeArgs& a [[buffer(3)]],
+                                 uint3 g [[thread_position_in_grid]]) {
+    if (g.x >= 32 || g.y >= a.heads) return;
+    const int pos = P[g.z];
+    if (pos < 0 || uint(pos) >= a.positions) return;
+    const ulong at = ulong(g.z) * a.row_stride + ulong(g.y) * a.head_stride + a.off + 2u * g.x;
+    const float x0 = tf_g_in(float(X[at])), x1 = tf_g_in(float(X[at + 1]));
+    const float c = CS[ulong(pos) * 64u + g.x], s = CS[ulong(pos) * 64u + 32u + g.x];
+    X[at] = bfloat(x0 * c + (TF_CTL == 2 ? x1 * s : -x1 * s));
+    X[at + 1] = bfloat(x0 * s + x1 * c);
+}
diff --git a/zig/kernels/metal/deepseek_v41/index_units.metal b/zig/kernels/metal/deepseek_v41/index_units.metal
new file mode 100644
index 0000000..08eb6d3
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/index_units.metal
@@ -0,0 +1,202 @@
+// 16 heads by 32 keys on the M5 tensor units. FP4 values and all 32-product unscaled sums are exact in FP32.
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+constexpr constant auto ix_shape = matmul2d_descriptor(16, 32, 32, false, true, false, matmul2d_descriptor::mode::multiply);
+using ix_weight_tile = tensor<device metal_fp4_e2m1_format, dextents<int32_t, 2>, tensor_inline>;
+
+[[kernel, max_total_threads_per_threadgroup(128)]]
+void tf_dsv41_ix_score_units(const device uchar* Q [[buffer(0)]], const device uchar* QS [[buffer(1)]],
+                            const device bfloat* W [[buffer(2)]], const device uchar* IK [[buffer(3)]],
+                            device float* S [[buffer(4)]], const device uchar* CM [[buffer(5)]],
+                            constant TfDsv41IxArgs& a [[buffer(6)]], uint2 tg [[threadgroup_position_in_grid]],
+                            uint lane [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+    threadgroup float partial[4][16][32];
+    const uint row = tg.y * 4u + sg;
+    if (row >= a.rows) return;
+    const uint first = tg.x * 32u, key = first + lane;
+    const uint visible = min(a.keys, (a.start + row) / a.ratio);
+    const bool live = key < visible && (!a.mask_stride || CM[size_t(row) * a.mask_stride + key / 8]);
+#if TF_CTL == 4 // contract control: overwrite the first guard word
+    if (row + 1u == a.rows && key + 1u == a.keys) S[size_t(a.rows) * a.out_stride] = 1.0f;
+#endif
+    if (!simd_any(live)) {
+        if (key < a.keys) S[size_t(row) * a.out_stride + key] = -INFINITY;
+        return;
+    }
+    // Admit whole physical tiles only. The dispatcher's original score kernel handles other shapes.
+    // Cooperative 16 x 32 fragments have two 8-row and two 16-column lane groups.
+    const uint hx = (lane & 8u) + ((lane & 1u) << 2);
+    const uint hy = ((lane & 16u) >> 2) | ((lane >> 1) & 3u);
+    const device uchar* qrow = Q + size_t(row) * QROW;
+    const device uchar* qscale = QS + size_t(row) * QSROW;
+    const device uchar* keys = IK + size_t(first) * a.ik_stride;
+    matmul2d<ix_shape, execution_simdgroup> op;
+    ix_weight_tile wt((device uchar*)keys, dextents<int32_t,2>(2 * a.ik_stride, 32));
+    float score = 0.0f;
+    for (uint tile = 0; tile < IH; tile += 16u) {
+#if TF_CTL == 2
+        const uint hb = IH - 16u - tile;
+#else
+        const uint hb = tile;
+#endif
+        float part[4][16];
+        UNR for (uint g = 0; g < 4u; ++g) {
+            auto kt = wt.slice<32,32>(32 * g, 0);
+            auto qt = op.get_left_input_cooperative_tensor<half,metal_fp4_e2m1_format,float>();
+            auto acc = op.get_destination_cooperative_tensor<metal::remove_addrspace_t<decltype(qt)>,metal::remove_addrspace_t<decltype(kt)>,float>();
+            UNR for (uint i = 0; i < 16u; ++i) {
+                const uint head = hb + hy + 8u * ((i >> 2) & 1u);
+                const uint d = hx + (i & 3u) + 16u * (i >> 3);
+                uchar byte = qrow[head * 64u + 16u * g + (d >> 1)];
+                qt[i] = tf_ix_lut[(byte >> (4u * (d & 1u))) & 15u];
+            }
+            op.run(qt, kt, acc);
+            UNR for (uint i = 0; i < 16u; ++i) {
+                uint head = hb + hy + 8u * ((i >> 2) & 1u);
+                uint col = hx + (i & 3u) + 16u * (i >> 3);
+                const float qs = tf_ix_e8m0(qscale[head * 4u + g]);
+                const float ks = tf_ix_e8m0(keys[col * a.ik_stride + 64u + g]);
+                float sum = acc[i];
+#if TF_CTL == 3 // contract control: round the group dot prematurely
+                sum = float(half(sum));
+#endif
+                part[g][i] = (sum * qs) * ks;
+            }
+        }
+        UNR for (uint i = 0; i < 16u; ++i) {
+            uint h = hy + 8u * ((i >> 2) & 1u);
+            uint col = hx + (i & 3u) + 16u * (i >> 3);
+            const float prod = (part[0][i] + part[1][i]) + (part[2][i] + part[3][i]);
+            const float w = float(W[size_t(row) * a.w_stride + hb + h]) * a.w_scale;
+            partial[sg][h][col] = float(bfloat(tf_ix_relu(float(bfloat(prod))) * w));
+        }
+        // Exchange head-by-key products so each lane folds one key in checkpoint head order.
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+#if TF_CTL == 2 // contract control: fold heads backwards and omit the first head
+        UNR for (uint i = 0; i < 16u; ++i) if (hb + 15u - i != 0u) score += partial[sg][15u - i][lane];
+#else
+        UNR for (uint h = 0; h < 16u; ++h) score += partial[sg][h][lane];
+#endif
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    S[size_t(row) * a.out_stride + key] = live ? float(bfloat(score)) : -INFINITY;
+}
+
+[[kernel, max_total_threads_per_threadgroup(128)]]
+void tf_ix_decode_units(const device uchar* Q [[buffer(0)]], const device uchar* QS [[buffer(1)]],
+                            const device bfloat* W [[buffer(2)]], const device uchar* IK [[buffer(3)]],
+                            device float* S [[buffer(4)]], const device uchar* CM [[buffer(5)]],
+                            constant TfDsv41IxArgs& a [[buffer(6)]], uint2 tg [[threadgroup_position_in_grid]],
+                            uint lane [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+    threadgroup float partial[4][16][32];
+    const uint row = tg.y;
+    if (row >= a.rows) return;
+    const uint first = (tg.x * 4u + sg) * 32u, key = first + lane;
+    if (first >= a.keys) return;
+    const uint visible = min(a.keys, (a.start + row) / a.ratio);
+    const bool live = key < visible && (!a.mask_stride || CM[size_t(row) * a.mask_stride + key / 8]);
+#if TF_CTL == 4 // contract control: overwrite the first guard word
+    if (row + 1u == a.rows && key + 1u == a.keys) S[size_t(a.rows) * a.out_stride] = 1.0f;
+#endif
+    if (!simd_any(live)) {
+        if (key < a.keys) S[size_t(row) * a.out_stride + key] = -INFINITY;
+        return;
+    }
+
+    bool safe_scale = true;
+    UNR for (uint g = 0; g != 4; ++g) {
+        const uchar exp = QS[size_t(row) * QSROW + lane * 4u + g];
+        safe_scale &= (exp >= 4u && exp <= 242u);
+    }
+    if (first + 32u > a.keys || !simd_all(safe_scale)) {
+        const float wh = float(W[size_t(row) * a.w_stride + lane]) * a.w_scale;
+        for (uint key = first; key < min(a.keys, first + 32u); ++key) {
+            if (key >= visible || (a.mask_stride && !CM[size_t(row) * a.mask_stride + key / CBS])) {
+                if (lane == 0u) S[size_t(row) * a.out_stride + key] = -INFINITY;
+                continue;
+            }
+    const device uchar* ik = IK + size_t(key) * a.ik_stride;
+    const device uchar* ks = ik + ID / 2u; // a key's row: 64 FP4 bytes then its 4 e8m0 scales
+    float p[4];
+    for (uint q = 0; q < 4u; ++q) {
+#if TF_CTL == 3 // gate 4's control: the group sums accumulated in half
+      half h = 0.0h;
+      for (uint i = 32u * q; i < 32u * q + 32u; ++i) h += half(tf_ix_q(Q, QS, size_t(row) * QROW, lane, i)) * half(tf_ix_e2m1((ik[i >> 1] >> (4u * (i & 1u))) & 0xFu));
+      p[q] = float(h);
+#else
+      float acc = 0.0f;
+      for (uint i = 32u * q; i < 32u * q + 32u; ++i) acc += tf_ix_q(Q, QS, size_t(row) * QROW, lane, i) * tf_ix_e2m1((ik[i >> 1] >> (4u * (i & 1u))) & 0xFu);
+      p[q] = acc;
+#endif
+    }
+    const float prod = ((p[0] * tf_ix_e8m0(ks[0])) + (p[1] * tf_ix_e8m0(ks[1]))) + ((p[2] * tf_ix_e8m0(ks[2])) + (p[3] * tf_ix_e8m0(ks[3])));
+    const float term = float(bfloat(tf_ix_relu(float(bfloat(prod))) * wh));
+    float acc = 0.0f;
+#if TF_CTL == 2 // gate 3's control: the head fold in reverse, and head 0 (the last one folded) dropped
+    for (uint h = IH - 1u; h >= 1u; --h) acc += simd_shuffle(term, ushort(h));
+#else
+    for (uint h = 0u; h < IH; ++h) acc += simd_shuffle(term, ushort(h));
+#endif
+    if (lane == 0u) S[size_t(row) * a.out_stride + key] = float(bfloat(acc));
+        }
+        return;
+    }
+
+    // Admit whole physical tiles only. The dispatcher's original score kernel handles other shapes.
+    // Cooperative 16 x 32 fragments have two 8-row and two 16-column lane groups.
+    const uint hx = (lane & 8u) + ((lane & 1u) << 2);
+    const uint hy = ((lane & 16u) >> 2) | ((lane >> 1) & 3u);
+    const device uchar* qrow = Q + size_t(row) * QROW;
+    const device uchar* qscale = QS + size_t(row) * QSROW;
+    const device uchar* keys = IK + size_t(first) * a.ik_stride;
+    matmul2d<ix_shape, execution_simdgroup> op;
+    ix_weight_tile wt((device uchar*)keys, dextents<int32_t,2>(2 * a.ik_stride, 32));
+    float score = 0.0f;
+    for (uint tile = 0; tile < IH; tile += 16u) {
+#if TF_CTL == 2
+        const uint hb = IH - 16u - tile;
+#else
+        const uint hb = tile;
+#endif
+        float part[4][16];
+        UNR for (uint g = 0; g < 4u; ++g) {
+            auto kt = wt.slice<32,32>(32 * g, 0);
+            auto qt = op.get_left_input_cooperative_tensor<half,metal_fp4_e2m1_format,float>();
+            auto acc = op.get_destination_cooperative_tensor<metal::remove_addrspace_t<decltype(qt)>,metal::remove_addrspace_t<decltype(kt)>,float>();
+            UNR for (uint i = 0; i < 16u; ++i) {
+                const uint head = hb + hy + 8u * ((i >> 2) & 1u);
+                const uint d = hx + (i & 3u) + 16u * (i >> 3);
+                uchar byte = qrow[head * 64u + 16u * g + (d >> 1)];
+                qt[i] = tf_ix_lut[(byte >> (4u * (d & 1u))) & 15u];
+            }
+            op.run(qt, kt, acc);
+            UNR for (uint i = 0; i < 16u; ++i) {
+                uint head = hb + hy + 8u * ((i >> 2) & 1u);
+                uint col = hx + (i & 3u) + 16u * (i >> 3);
+                const float qs = tf_ix_e8m0(qscale[head * 4u + g]);
+                const float ks = tf_ix_e8m0(keys[col * a.ik_stride + 64u + g]);
+                float sum = acc[i];
+#if TF_CTL == 3 // contract control: round the group dot prematurely
+                sum = float(half(sum));
+#endif
+                part[g][i] = (sum * qs) * ks;
+            }
+        }
+        UNR for (uint i = 0; i < 16u; ++i) {
+            uint h = hy + 8u * ((i >> 2) & 1u);
+            uint col = hx + (i & 3u) + 16u * (i >> 3);
+            const float prod = (part[0][i] + part[1][i]) + (part[2][i] + part[3][i]);
+            const float w = float(W[size_t(row) * a.w_stride + hb + h]) * a.w_scale;
+            partial[sg][h][col] = float(bfloat(tf_ix_relu(float(bfloat(prod))) * w));
+        }
+        // Exchange head-by-key products so each lane folds one key in checkpoint head order.
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+#if TF_CTL == 2 // contract control: fold heads backwards and omit the first head
+        UNR for (uint i = 0; i < 16u; ++i) if (hb + 15u - i != 0u) score += partial[sg][15u - i][lane];
+#else
+        UNR for (uint h = 0; h < 16u; ++h) score += partial[sg][h][lane];
+#endif
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    S[size_t(row) * a.out_stride + key] = live ? float(bfloat(score)) : -INFINITY;
+}
