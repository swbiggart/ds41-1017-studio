diff --git a/zig/src/families/deepseek_v41/metal/vocab_head.zig b/zig/src/families/deepseek_v41/metal/vocab_head.zig
new file mode 100644
index 0000000..48a3a66
--- /dev/null
+++ b/zig/src/families/deepseek_v41/metal/vocab_head.zig
@@ -0,0 +1,83 @@
+//! Reversible coalesced BF16 vocabulary head for 1..16 row decode/verification.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const Ref = @import("glue.zig").Ref;
+
+const hidden = 5120;
+const vocab = 129280;
+const elements = @as(usize, hidden) * vocab;
+const Args = extern struct { k: u32, n: u32, rows: u32 };
+
+pub const Layout = struct {
+    buffer: mtl.Buffer,
+    allocator: std.mem.Allocator,
+    by_rows: [16]mtl.Pipeline,
+
+    pub fn init(a: std.mem.Allocator, device: mtl.Device, queue: mtl.Queue, original: Ref) !*Layout {
+        const pool = mtl.objc.Pool.push();
+        defer pool.pop();
+        const combined = try std.mem.concat(a, u8, &.{ sources.dsv41.mv, "\n", sources.dsv41.vocab_head });
+        defer a.free(combined);
+        const lib = try mtl.Library.fromSource(device, combined, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const pack = try mtl.Pipeline.init(device, lib, "vocab_pack", false);
+        defer pack.deinit();
+        const audit = try mtl.Pipeline.init(device, lib, "vocab_pack_check", false);
+        defer audit.deinit();
+        const state = try a.create(Layout);
+        errdefer a.destroy(state);
+        state.allocator = a;
+        state.buffer = try device.buffer(elements * 2, mtl.ResourceOptions.private);
+        errdefer state.buffer.deinit();
+        var loaded: usize = 0;
+        errdefer for (state.by_rows[0..loaded]) |p| p.deinit();
+        inline for (1..17) |rows| {
+            state.by_rows[rows - 1] = try mtl.Pipeline.init(device, lib, std.fmt.comptimePrint("vocab_r{d}", .{rows}), false);
+            loaded += 1;
+        }
+        const errors = try device.buffer(4, mtl.ResourceOptions.shared);
+        defer errors.deinit();
+        const check: *u32 = @ptrCast(@alignCast(errors.contents()));
+        check.* = 0;
+        const cb = queue.commandBuffer();
+        const e = cb.compute(.serial);
+        e.setPipeline(pack);
+        e.setBuffer(original.buf, original.off, 0);
+        e.setBuffer(state.buffer, 0, 1);
+        e.dispatchThreads(mtl.Size.of(elements / 4, 1, 1), mtl.Size.of(256, 1, 1));
+        e.barrier();
+        e.setPipeline(audit);
+        e.setBuffer(original.buf, original.off, 0);
+        e.setBuffer(state.buffer, 0, 1);
+        e.setBuffer(errors, 0, 2);
+        e.dispatchThreads(mtl.Size.of(elements / 4, 1, 1), mtl.Size.of(256, 1, 1));
+        e.end();
+        cb.commit();
+        cb.wait();
+        if (cb.failure()) |err| {
+            std.log.err("packed vocabulary head command failed: {s}", .{err});
+            return error.VocabularyHeadCommandFailed;
+        }
+        if (check.* != 0) return error.VocabularyHeadLayoutMismatch;
+        std.log.info("dsv41 vocabulary head: {d} BF16 values packed and verified, for batches of 1 to 16 rows", .{elements});
+        return state;
+    }
+
+    pub fn deinit(state: *Layout) void {
+        for (state.by_rows) |p| p.deinit();
+        state.buffer.deinit();
+        state.allocator.destroy(state);
+    }
+
+    pub fn encode(state: *const Layout, e: mtl.ComputeEncoder, x: Ref, y: Ref, rows: u32) void {
+        std.debug.assert(rows >= 1 and rows <= 16);
+        const columns: usize = if (rows <= 8) 2 else 1;
+        e.setPipeline(state.by_rows[rows - 1]);
+        e.setBuffer(x.buf, x.off, 0);
+        e.setBuffer(state.buffer, 0, 1);
+        e.setBuffer(y.buf, y.off, 2);
+        e.setValue(Args{ .k = hidden, .n = vocab, .rows = rows }, 3);
+        e.dispatchGroups(mtl.Size.of(vocab / (4 * columns), 1, 1), mtl.Size.of(128, 1, 1));
+    }
+};
