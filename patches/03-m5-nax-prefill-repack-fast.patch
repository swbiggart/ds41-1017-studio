+        return cb;
+    }
+    fn submit(layout: *const Layout, queue: mtl.Queue, kernels: *const Kernels, original: mtl.Buffer, backing: []const mtl.Buffer, verify: bool) mtl.CommandBuffer {
+        const cb = queue.commandBuffer();
+        const e = cb.compute(.serial);
+        ex.use(e, backing);
+        for (layout.matrices, 0..) |dest, kind| {
+            const K = if (kind == 2) layout.shape.n else layout.shape.k;
+            const N = if (kind == 2) layout.shape.k else layout.shape.n;
+            for (0..@as(usize, if (verify) 2 else 1)) |phase| {
+                e.setPipeline(kernels.code[3 + phase]);
+                e.setBuffer(original, 0, 0);
+                e.setBuffer(dest, 0, 1);
+                e.setValue([4]u32{ K, N, @intCast(kind), 0 }, 2);
+                if (phase == 1) e.setBuffer(layout.check, 0, 3);
+                e.dispatchThreads(mtl.Size.of(K / 16 * N, layout.shape.experts, 1), mtl.Size.of(256, 1, 1));
+            }
+        }
+        e.end();
+        cb.commit();
+        return cb;
+    }
+
+    pub fn prepare(device: mtl.Device, queue: mtl.Queue, kernels: *const Kernels, original: mtl.Buffer, backing: []const mtl.Buffer, c: xm.Call) !Layout {
+        var layout = try init(device, c);
+        errdefer layout.deinit();
+        try layout.refresh(queue, kernels, original, backing, true);
+        return layout;
+    }
+    pub fn deinit(layout: *Layout) void {
+        for (&layout.matrices) |*b| b.deinit();
+        layout.check.deinit();
+        layout.table.deinit();
+    }
+};
+
+pub const Work = struct { codes: ex.Ref, scales: ex.Ref, down_codes: ex.Ref, down_scales: ex.Ref };
+const Args = extern struct { K: u32, N: u32, topk: u32, pairs: u32, limit: f32 };
+fn bind(e: mtl.ComputeEncoder, refs: []const ex.Ref) void {
+    for (refs, 0..) |v, i| e.setBuffer(v.buf, v.off, i);
+}
+
+pub fn up(kernels: *const Kernels, e: mtl.ComputeEncoder, layout: *const Layout, work: Work, x: ex.Ref, xs: ex.Ref, route: ex.Route, tiles: ex.Ref, act: ex.Ref, c: xm.Call) void {
+    ex.use(e, &layout.matrices);
+    const count = xm.maxTiles(c);
+    e.setPipeline(kernels.code[0]);
+    bind(e, &.{ x, xs, tiles, route.pairs, work.codes, work.scales });
+    e.setValue([2]u32{ c.k, xm.topk }, 6);
+    e.dispatchThreads(mtl.Size.of(c.k, count * 16, 1), mtl.Size.of(256, 1, 1));
+    e.setPipeline(kernels.code[1]);
+    bind(e, &.{ work.codes, work.scales, .{ .buf = layout.table }, tiles, route.pairs, route.weights, act, work.down_codes, work.down_scales });
+    e.setValue(Args{ .K = c.k, .N = c.n, .topk = xm.topk, .pairs = c.rows * xm.topk, .limit = ex.swiglu_limit }, 9);
+    e.dispatchGroups(mtl.Size.of(c.n / width, count, 1), mtl.Size.of(64, 1, 1));
+}
+pub fn down(kernels: *const Kernels, e: mtl.ComputeEncoder, layout: *const Layout, work: Work, tiles: ex.Ref, out: ex.Ref, c: xm.Call) void {
+    e.setPipeline(kernels.code[2]);
+    bind(e, &.{ work.down_codes, work.down_scales, .{ .buf = layout.table }, tiles, out });
+    e.setValue(Args{ .K = c.n, .N = c.k, .topk = xm.topk, .pairs = c.rows * xm.topk, .limit = 0 }, 5);
+    e.dispatchGroups(mtl.Size.of(c.k / width, xm.maxTiles(c), 1), mtl.Size.of(32, 1, 1));
+}
