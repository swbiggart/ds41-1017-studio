+        errdefer for (layout.matrices[0..made]) |b| b.deinit();
+        for (&layout.matrices) |*b| {
+            b.* = try device.buffer(length, mtl.ResourceOptions.private);
+            made += 1;
+        }
+        const addresses = layout.table.slice(ex.ExpertPtrs, c.experts);
+        for (addresses, 0..) |*addr, expert| {
+            const offset = matrix_elements * expert;
+            addr.* = .{ .w1p = layout.matrices[0].gpuAddress() + offset, .w1s = 0, .w3p = layout.matrices[1].gpuAddress() + offset, .w3s = 0, .w2p = layout.matrices[2].gpuAddress() + offset, .w2s = 0 };
+        }
+        return layout;
+    }
+
+    /// Synchronously repack into this layout. The owning encoder must finish all prior consumers before reuse.
+    /// Audit every new immutable source, even with force_verify=false. Previously audited sources only need rebinding.
+    pub fn refresh(layout: *Layout, queue: mtl.Queue, kernels: *const Kernels, original: mtl.Buffer, backing: []const mtl.Buffer, force_verify: bool) !void {
+        if (original.length() < layout.table.length()) return error.BadFoldedExpertTable;
+        const identity = original.gpuAddress();
+        if (identity == 0) return error.BadFoldedExpertTable;
