index 0000000..c8e83ae
--- /dev/null
+++ b/zig/src/families/deepseek_v41/metal/folded_experts.zig
@@ -0,0 +1,182 @@
+//! Prompt-only FP8 tensor unit views of the original FP4 experts. Scale shifts are audited at boot.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const xm = @import("experts_mma.zig");
+const ex = @import("experts.zig");
+const environment = @import("sys").environment;
+
+pub const width = 64;
+pub fn layerCount() !u32 {
+    return environment.read(u32, "TF_DSV41_FOLDED_EXPERT_LAYERS", 0);
+}
+
+/// Stage one expert layer at a time for a schedule that reuses it over several chunks.
+pub fn stagingEnabled() !bool {
+    const def = try environment.read(bool, "TF_DSV41_M5_FAST_DECODE", false);
+    return environment.read(bool, "TF_DSV41_STAGE_FOLDED_EXPERTS", def);
+}
+pub fn enabled() !bool {
+    return (try layerCount()) > 0 or try stagingEnabled();
+}
+
+pub const Kernels = struct {
+    code: [5]mtl.Pipeline,
+    pub fn load(a: std.mem.Allocator, device: mtl.Device) !Kernels {
+        if (!xm.units(device)) return error.FoldedExpertsRequireTensorUnits;
+        const prefix = try xm.source(a, "", &.{}, true);
+        defer a.free(prefix);
+        const text = try std.mem.concat(a, u8, &.{ prefix, sources.dsv41.folded_experts });
+        defer a.free(text);
+        const lib = try mtl.Library.fromSource(device, text, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var result: Kernels = undefined;
+        var made: usize = 0;
+        errdefer for (result.code[0..made]) |p| p.deinit();
+        for (&result.code, [_][]const u8{ "xu_gather_fp8", "xu_ordered_up", "xu_ordered_down", "xu_weight_pack", "xu_weight_check" }) |*p, name| {
+            p.* = try mtl.Pipeline.init(device, lib, name, false);
+            made += 1;
+        }
+        return result;
+    }
+    pub fn deinit(p: *Kernels) void {
+        for (&p.code) |*v| v.deinit();
+    }
+};
+
+pub const Layout = struct {
+    table: mtl.Buffer,
+    matrices: [3]mtl.Buffer,
+    check: mtl.Buffer,
+    shape: xm.Call,
+    /// Source tables are immutable for the lifetime of a loaded checkpoint. The three MTP layers have different shapes.
+    audited: [40]u64 = @splat(0),
+    current: u64 = 0,
+    /// The most recent synchronous refresh. A resident hit has zero GPU cost.
+    last_gpu_seconds: f64 = 0,
+    last_audited: bool = false,
+
+    pub fn init(device: mtl.Device, c: xm.Call) !Layout {
+        if (c.k == 0 or c.n == 0 or c.experts == 0 or c.k % width != 0 or c.n % width != 0) return error.UnsupportedFoldedExpertShape;
+        const matrix_elements = @as(usize, c.k) * c.n;
+        const length = try std.math.mul(usize, matrix_elements, c.experts);
+        if (length > device.maxBufferLength()) return error.FoldedMatrixTooLarge;
+        var layout: Layout = .{ .table = try device.buffer(@as(usize, c.experts) * @sizeOf(ex.ExpertPtrs), mtl.ResourceOptions.shared), .matrices = undefined, .check = undefined, .shape = c };
