+    defer a.free(rpath);
+    const text = std.Io.Dir.cwd().readFileAlloc(io, rpath, a, .limited(1 << 20)) catch return false;
+    defer a.free(text);
+    const parsed = std.json.parseFromSlice(std.json.Value, a, text, .{}) catch return false;
+    defer parsed.deinit();
+    if (parsed.value != .object) return false;
+    if ((num(parsed.value.object.get("schema")) orelse 0) != 1) return false;
+    const skipped = parsed.value.object.get("skipped_engram_tensors") orelse return false;
