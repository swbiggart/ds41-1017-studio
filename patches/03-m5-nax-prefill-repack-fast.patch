index 0000000..5558bb7
--- /dev/null
+++ b/zig/src/families/deepseek_v41/metal/prompt_band.zig
@@ -0,0 +1,87 @@
+//! Persistent per-position state for a band of ordinary-sized encoder chunks.
+//! Projection workspaces and each layer's KV ring retain their normal shape.
+const std = @import("std");
+const mtl = @import("metal");
+const Config = @import("dsv41").config.Config;
+const ctx = @import("ctx.zig");
+const ps = @import("prompt_scratch.zig");
+const pl = @import("prompt_layer.zig");
+const attn = @import("pipelines.zig").attn;
+
+pub const Band = struct {
+    // Hidden+pre ping-pong, selected ids+candidate flags, metadata+ids,
+    // then one independent input plane per Engram layer.
+    buf: [8]mtl.Buffer = undefined,
+    nbuf: usize = 0,
+    rows: usize,
+    chunk: usize,
+    chunks: usize,
+    hidden: usize,
+    mask_stride: usize,
+    meta_stride: usize,
+    engram_stride: usize,
+
+    pub fn init(device: mtl.Device, c: *const Config, s: *const ps.Scratch, rows: usize, encoder_layers: u32) !Band {
+        const chunks = std.math.divCeil(usize, rows, s.rows) catch return error.BadRows;
+        var needs_masks = false;
+        for (0..encoder_layers) |li| {
+            const layer: u32 = @intCast(li);
+            if (c.isCandidateSource(layer) or c.usesCandidates(layer)) needs_masks = true;
+        }
+        var band = Band{ .rows = rows, .chunk = s.rows, .chunks = chunks, .hidden = c.hidden, .mask_stride = if (needs_masks) s.blocks else 0, .meta_stride = std.mem.alignForward(usize, s.rec.ints * 4, 256), .engram_stride = @as(usize, c.hashCols()) * c.engram_head_dim * 2 };
+        errdefer band.deinit();
+        const hidden = rows * (8 * band.hidden + 16);
+        try band.add(device, hidden);
+        try band.add(device, hidden);
+        try band.add(device, rows * (4 * attn.max_selected + band.mask_stride));
+        try band.add(device, chunks * band.meta_stride + rows * 4);
+        for (0..c.engram_layers.len) |_| try band.add(device, rows * band.engram_stride);
+        return band;
+    }
+
+    fn add(b: *Band, device: mtl.Device, bytes: usize) !void {
+        if (b.nbuf == b.buf.len) return error.TooManyEngramLayers;
+        b.buf[b.nbuf] = try device.buffer(@max(4, bytes), mtl.ResourceOptions.shared);
+        b.nbuf += 1;
+    }
+
+    pub fn deinit(b: *Band) void {
+        for (b.buf[0..b.nbuf]) |storage| storage.deinit();
+    }
+
+    pub fn io(b: *const Band, parity: usize, row: usize) pl.Io {
+        const x = row * 8 * b.hidden;
+        const mix = b.rows * 8 * b.hidden + row * 16;
+        return .{ .x = .{ .buf = b.buf[parity], .off = x }, .pre = .{ .buf = b.buf[parity], .off = mix }, .x_out = .{ .buf = b.buf[1 - parity], .off = x }, .pre_out = .{ .buf = b.buf[1 - parity], .off = mix } };
+    }
+
+    pub fn ids(b: *const Band) ctx.Ref {
+        return .{ .buf = b.buf[3], .off = b.meta_stride * b.chunks };
+    }
+
+    pub fn engramRows(b: *const Band, li: usize, row: usize) ctx.Ref {
+        return .{ .buf = b.buf[4 + li], .off = row * b.engram_stride };
+    }
+
+    pub fn prepare(b: *const Band, s: *ps.Scratch, c: *const Config, tokens: []const u32, first: u32, cap: u32) !void {
+        if (tokens.len != b.rows) return error.BadRows;
+        for (tokens) |id| if (id >= c.vocab) return error.BadToken;
+        const input = b.ids();
+        @memcpy((input.buf.contents() + input.off)[0 .. tokens.len * 4], std.mem.sliceAsBytes(tokens));
+        for (0..b.chunks) |j| {
+            const off = j * b.chunk;
+            try s.writeRows(c, first + @as(u32, @intCast(off)), @intCast(@min(b.chunk, b.rows - off)), cap);
+            const bytes = s.rec.ints * 4;
+            @memcpy((b.buf[3].contents() + j * b.meta_stride)[0..bytes], s.bytes(s.meta, bytes));
+        }
+    }
+
+    pub fn scratch(b: *const Band, base: *const ps.Scratch, j: usize) ps.Scratch {
+        var s = base.*;
+        const row = j * b.chunk;
+        s.sel = .{ .buf = b.buf[2], .off = row * attn.max_selected * 4 };
+        if (b.mask_stride != 0) s.cmask = .{ .buf = b.buf[2], .off = b.rows * attn.max_selected * 4 + row * b.mask_stride };
+        s.meta = .{ .buf = b.buf[3], .off = j * b.meta_stride };
+        return s;
+    }
+};
