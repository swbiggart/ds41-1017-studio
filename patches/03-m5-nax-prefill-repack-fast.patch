+// Single-pass M5 Ultra Metal 4.1 NAX dense FP8 (E4M3 x E4M3) & BF16 (BF16 x BF16) kernels.
+// Standalone source for fp8_mma_fast.zig (zero edits to upstream fp8_mma.metal).
+#include <metal_stdlib>
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace metal;
+using namespace mpp::tensor_ops;
+
+#pragma METAL fp contract(off)
+struct OrderedArgs { uint k, n, rows; long ws, ss, ys, xs, sxs; };
+
+constexpr constant auto ord_desc = matmul2d_descriptor(16, 32, 32, false, true, false,
+                                                       matmul2d_descriptor::mode::multiply);
+using fp8_tensor = tensor<device metal_fp8_e4m3_format, dextents<int32_t, 2>, tensor_inline>;
+
+inline float ord_e8m0(uint x) {
+    return x == 255 ? NAN : as_type<float>(x == 0 ? 0x00400000u : x << 23);
+}
+
+template<typename T>
+kernel void ordered(const device uchar* x [[buffer(0)]], const device uchar* w [[buffer(1)]],
+                    const device uchar* sw [[buffer(2)]], device T* y [[buffer(3)]],
+                    constant OrderedArgs& a [[buffer(4)]], const device float* sx [[buffer(5)]],
+                    uint3 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {
+    const uint r0 = 16 * tg.y, c0 = 32 * tg.x, groups = a.k / 32;
+    x += long(tg.z) * a.xs;
+    sx += long(tg.z) * a.sxs;
+    w += long(tg.z) * a.ws;
+    sw += long(tg.z) * a.ss;
+    y = (device T*)((device char*)y + long(tg.z) * a.ys);
+    fp8_tensor left((device uchar*)x + r0 * a.k, dextents<int32_t, 2>(a.k, 16));
+    fp8_tensor right((device uchar*)w + c0 * a.k, dextents<int32_t, 2>(a.k, 32));
+    matmul2d<ord_desc, execution_simdgroup> op;
+    const uint hx = (lane & 8) + ((lane & 1) << 2), hy = ((lane & 16) >> 2) | ((lane >> 1) & 3);
+    float sum[16] = {};
+    for (uint g = 0; g < groups; ++g) {
+        auto xa = left.slice<32, 16>(32 * g, 0);
+        auto wb = right.slice<32, 32>(32 * g, 0);
+        auto part = op.get_destination_cooperative_tensor<decltype(xa), decltype(wb), float>();
+        op.run(xa, wb, part);
+        const float ws = ord_e8m0(sw[tg.x * groups + g]);
+        const float2 as = float2(sx[(r0 + hy) * groups + g], sx[(r0 + hy + 8) * groups + g]);
+        #pragma unroll
+        for (uint i = 0; i < 16; ++i)
+            sum[i] += (part[i] * as[(i >> 2) & 1]) * ws;
+    }
+    #pragma unroll
+    for (uint i = 0; i < 16; ++i) {
+        const uint r = r0 + hy + 8 * ((i >> 2) & 1);
+        if (r < a.rows) y[r * a.n + c0 + hx + (i & 3) + 16 * (i >> 3)] = T(sum[i]);
+    }
+}
+template [[host_name("ordered_f32")]] [[kernel]] decltype(ordered<float>) ordered<float>;
+template [[host_name("ordered_bf16")]] [[kernel]] decltype(ordered<bfloat>) ordered<bfloat>;
