new file mode 100644
index 0000000..26371ed
--- /dev/null
+++ b/zig/src/families/deepseek_v41/metal/prompt_band_experts.zig
@@ -0,0 +1,84 @@
+//! Scratch shared by consecutive, full-size chunks for one routed expert dispatch.
+//! Attention, router projections, shared experts, and HC keep their ordinary chunk shape.
+const std = @import("std");
+const mtl = @import("metal");
+const Config = @import("dsv41").config.Config;
+const ctx = @import("ctx.zig");
+const ps = @import("prompt_scratch.zig");
+const ex = @import("experts.zig");
+const xm = @import("experts_mma.zig");
+
+pub const Group = struct {
+    cap: usize,
+    hidden: usize,
+    topk: usize,
+    work: ps.Scratch,
+    owned: [22]mtl.Buffer = undefined,
+    count: usize = 0,
+    bytes: usize = 0,
+
+    pub fn init(device: mtl.Device, c: *const Config, base: *const ps.Scratch, chunks: usize) !Group {
+        if ((chunks != 2 and chunks != 4) or base.rows != 4096 or c.hidden != ex.hidden or
+            c.expert_width != ex.width or c.topk != ex.topk or c.experts != ex.experts) return error.UnsupportedExpertGroup;
+        var g = Group{ .cap = chunks, .hidden = c.hidden, .topk = c.topk, .work = base.* };
+        errdefer g.deinit();
+        const rows = chunks * base.rows;
+        const pairs = rows * c.topk;
+        const call: xm.Call = .{ .rows = @intCast(rows), .k = c.hidden, .n = c.expert_width, .experts = c.experts };
+        const xb = xm.bytes(call, base.units);
+        const s = &g.work;
+        s.x1 = try g.add(device, rows * 8 * c.hidden);
+        s.mix_f[1] = try g.add(device, rows * 16);
+        s.mix_f[2] = try g.add(device, rows * 64);
+        s.hn2 = try g.add(device, rows * 2 * c.hidden);
+        s.picks = try g.add(device, pairs * 4);
+        s.wts = try g.add(device, pairs * 4);
+        s.yr = try g.add(device, rows * 4 * c.hidden);
+        s.ones = try g.add(device, pairs * 4);
+        const ones: []f32 = @alignCast(std.mem.bytesAsSlice(f32, s.ones.buf.contents()[0 .. pairs * 4]));
+        @memset(ones, 1);
+        for (&s.plan, [4]usize{ 12 * c.experts, 4, pairs * 4, pairs * 4 }) |*p, n| p.* = try g.add(device, n);
+        s.xtiles = try g.add(device, xb[0]);
+        s.xcodes = try g.add(device, xb[1]);
+        s.xscales = try g.add(device, xb[2]);
+        s.act = try g.add(device, xb[3]);
+        s.eout = try g.add(device, xb[4]);
+        s.xdq = try g.add(device, xb[5]);
+        if (base.folded) {
+            const padded: usize = 16 * xm.maxTiles(call);
+            s.folded_work = .{
+                .codes = ctx.cv(ex.Ref, try g.add(device, padded * c.hidden)),
+                .scales = ctx.cv(ex.Ref, try g.add(device, padded * c.hidden / 32 * 4)),
+                .down_codes = ctx.cv(ex.Ref, try g.add(device, padded * c.expert_width)),
+                .down_scales = ctx.cv(ex.Ref, try g.add(device, padded * c.expert_width / 32 * 4)),
+            };
+        }
+        return g;
+    }
+
+    fn add(g: *Group, device: mtl.Device, bytes: usize) !ctx.Ref {
+        const len = @max(bytes, 4);
+        const b = try device.buffer(len, mtl.ResourceOptions.shared);
+        g.owned[g.count] = b;
+        g.count += 1;
+        g.bytes += len;
+        return .{ .buf = b };
+    }
+
+    pub fn deinit(g: *Group) void {
+        for (g.owned[0..g.count]) |b| b.deinit();
+        g.count = 0;
+    }
+
+    /// Rebind only the retained activations. The chunk's attention metadata and remaining scratch are independent.
+    pub fn bindChunk(g: *const Group, s: *ps.Scratch, slot: usize) void {
+        const row = slot * s.rows;
+        s.x1 = ctx.plus(g.work.x1, row * 8 * g.hidden);
+        s.mix_f[1] = ctx.plus(g.work.mix_f[1], row * 16);
+        s.mix_f[2] = ctx.plus(g.work.mix_f[2], row * 64);
+        s.hn2 = ctx.plus(g.work.hn2, row * 2 * g.hidden);
+        s.picks = ctx.plus(g.work.picks, row * 4 * g.topk);
+        s.wts = ctx.plus(g.work.wts, row * 4 * g.topk);
+        s.yr = ctx.plus(g.work.yr, row * 4 * g.hidden);
+    }
+};
