+// Fused transpose + act_quant + FP8 pack for WO-B from group-major WO-A output [8][rows][1024].
+inline int ord_log2c(float v) {
+    const uint b = as_type<uint>(v);
+    return int(b >> 23) - 127 + int((b & 0x7FFFFFu) != 0);
+}
+inline float ord_pow2(int e) { return as_type<float>(uint(e + 127) << 23); }
+inline uint ord_e4m3_code(float a) {
+    if (a < 0.015625f) return uint(rint(a * 512.0f));
+    uint b = as_type<uint>(a);
+    b += 0x7FFFFu + ((b >> 20) & 1u);
+    return (((b >> 23) - 120u) << 3) | ((b >> 20) & 7u);
+}
+inline float ord_e4m3_val(uint c) { return float(as_type<half>(ushort((c & 0x7Fu) << 7))) * 256.0f; }
+inline bfloat ord_actq(float v) {
+    const bool bad = simd_any(!isfinite(v));
+    const float amax = simd_max(fabs(v));
+    const int e = ord_log2c(max(amax, 1e-4f) * (1.0f / 448.0f));
+    const float q = ord_e4m3_val(ord_e4m3_code(min(fabs(v) * ord_pow2(-e), 448.0f))) * ord_pow2(e);
+    return bfloat(bad ? NAN : (signbit(v) ? -q : q));
+}
