+template <uint Rows, bool TileCodes, bool TileScales>
+kernel void pack_dense_fp8(device const bfloat* x [[buffer(0)]], device uchar* xc [[buffer(1)]],
+                           device float* sx [[buffer(2)]], constant OrderedArgs& a [[buffer(3)]],
+                           uint2 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+                           uint sg [[simdgroup_index_in_threadgroup]]) {
+    const uint out_row = tg.y * Rows + sg;
+    const uint k = tg.x * 32 + lane, r = min(out_row, a.rows - 1);
+    const uint tile_base = (out_row / 64) * 64, local_row = out_row % 64;
+    const float val = float(x[ulong(r) * a.k + k]);
+    const bool bad = simd_any(!isfinite(val));
+    const float peak = simd_max(fabs(val));
+    const uint scale_bits = as_type<uint>(max(peak, 1e-4f) * (1.0f / 448.0f));
+    const int e = int(scale_bits >> 23) - 127 + int((scale_bits & 0x7FFFFFu) != 0);
+    const float mag = min(fabs(val) * as_type<float>(uint(127 - e) << 23), 448.0f);
+    uint bits = as_type<uint>(mag);
+    bits += 0x7FFFFu + ((bits >> 20) & 1u);
+    uint code = mag < 0.015625f ? uint(rint(mag * 512.0f)) : (((bits >> 23) - 120u) << 3) | ((bits >> 20) & 7u);
+    const ulong packed = TileCodes ? ulong(tile_base) * a.k + (64u * tg.x + local_row) * 32u + lane : ulong(out_row) * a.k + k;
+    xc[packed] = bad ? 0 : uchar(code | (signbit(val) ? 128u : 0u));
+    const ulong scale = TileScales ? ulong(tile_base) * (a.k / 32u) + 64u * tg.x + local_row : ulong(out_row) * (a.k / 32u) + tg.x;
+    if (lane == 0) sx[scale] = bad ? NAN : as_type<float>(uint(e + 127) << 23);
+}
+template [[host_name("tf_dsv41_pack_dense_fp8")]] [[kernel]] decltype(pack_dense_fp8<1,false,false>) pack_dense_fp8<1,false,false>;
+template [[host_name("pack_four_rows")]] [[kernel]] decltype(pack_dense_fp8<4,false,false>) pack_dense_fp8<4,false,false>;
+template [[host_name("pack_four_scale_tiles")]] [[kernel]] decltype(pack_dense_fp8<4,false,true>) pack_dense_fp8<4,false,true>;
+template [[host_name("pack_four_input_tiles")]] [[kernel]] decltype(pack_dense_fp8<4,true,true>) pack_dense_fp8<4,true,true>;
