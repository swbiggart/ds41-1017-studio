index 0000000..57ce633
--- /dev/null
+++ b/zig/src/families/deepseek_v41/engram_selected.zig
@@ -0,0 +1,84 @@
+//! A bounded set of exact, decoded rows for one immutable Engram source and layer in one prompt.
+const std = @import("std");
+const host = @import("engram_host.zig");
+
+pub const Selected = struct {
+    a: std.mem.Allocator,
+    source: ?host.Source,
+    layer: usize,
+    dim: usize,
+    capacity: usize,
+    bytes: []u16,
+    map: std.AutoHashMapUnmanaged(i64, u32) = .empty,
+    positions: std.ArrayList(u32) = .empty,
+    fresh: std.ArrayList(i64) = .empty,
+    fetched: usize = 0,
+
+    pub fn init(a: std.mem.Allocator, source: ?host.Source, layer: usize, dim: usize, max_rows: usize) !Selected {
+        if (dim == 0 or max_rows == 0) return error.BadEngramRows;
+        // At 256 bf16 values this permits 2,097,152 distinct rows in a 1 GiB address range.
+        const capacity = @min(max_rows, (1 << 30) / (2 * dim), std.math.maxInt(u32));
+        if (capacity == 0) return error.BadEngramRows;
+        return .{ .a = a, .source = source, .layer = layer, .dim = dim, .capacity = capacity,
+            .bytes = try a.alloc(u16, try std.math.mul(usize, capacity, dim)) };
+    }
+
+    pub fn deinit(s: *Selected) void {
+        s.map.deinit(s.a);
+        s.positions.deinit(s.a);
+        s.fresh.deinit(s.a);
+        s.a.free(s.bytes);
+    }
+
+    fn readSource(s: *const Selected, idx: []const i64, out: []u16) !void {
+        if (s.source) |src| return src.vtable.rows(src.ptr, s.layer, idx, s.dim, out);
+        host.indexRows(idx, s.dim, out);
+    }
+
+    pub fn read(s: *Selected, idx: []const i64, out: []u16) !void {
+        if (out.len != try std.math.mul(usize, idx.len, s.dim)) return error.BadEngramRows;
+        if (idx.len > s.capacity) return s.readSource(idx, out);
+        if (idx.len > s.capacity - s.map.count()) s.map.clearRetainingCapacity();
+        // A failed or partial source read cannot publish uninitialized BF16 bytes to a subsequent request.
+        errdefer s.map.clearRetainingCapacity();
+        try s.map.ensureUnusedCapacity(s.a, @intCast(idx.len));
+        try s.positions.resize(s.a, idx.len);
+        s.fresh.clearRetainingCapacity();
+        try s.fresh.ensureTotalCapacity(s.a, idx.len);
+        const base = s.map.count();
+        for (idx, s.positions.items) |id, *position| {
+            const item = s.map.getOrPutAssumeCapacity(id);
+            if (!item.found_existing) {
+                item.value_ptr.* = @intCast(base + s.fresh.items.len);
+                s.fresh.appendAssumeCapacity(id);
+            }
+            position.* = item.value_ptr.*;
+        }
+        if (s.fresh.items.len != 0) {
+            try s.readSource(s.fresh.items, s.bytes[@as(usize, base) * s.dim .. @as(usize, s.map.count()) * s.dim]);
+            s.fetched += s.fresh.items.len;
+        }
+        for (s.positions.items, 0..) |p, i|
+            @memcpy(out[i * s.dim ..][0..s.dim], s.bytes[@as(usize, p) * s.dim ..][0..s.dim]);
+    }
+};
+
+/// A single encode call owns these caches; its successive band workers run one at a time and join before reuse.
+pub const Request = struct {
+    layers: [host.max_layers]?Selected = @splat(null),
+
+    pub fn deinit(r: *Request) void {
+        for (&r.layers) |*layer| if (layer.*) |*cache| cache.deinit();
+    }
+
+    pub fn get(r: *Request, a: std.mem.Allocator, source: ?host.Source, li: usize, dim: usize, rows: usize) !?*Selected {
+        if (li >= r.layers.len) return error.NotEngram;
+        if (r.layers[li] == null) {
+            r.layers[li] = Selected.init(a, source, li, dim, rows) catch |err| switch (err) {
+                error.OutOfMemory => return null,
+                else => return err,
+            };
+        }
+        return &r.layers[li].?;
+    }
+};
