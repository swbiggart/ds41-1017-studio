+// Parallel K-blocks for at most 16 rows (ordered_small_8 and verify_small_16 for R<=8).
+template <uint S, uint MaxRows = 16>
+kernel void ordered_small(const device uchar* x [[buffer(0)]], const device uchar* w [[buffer(1)]],
+                          const device uchar* sw [[buffer(2)]], device bfloat* y [[buffer(3)]],
+                          constant OrderedArgs& a [[buffer(4)]], const device float* sx [[buffer(5)]],
+                          uint3 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+                          uint sg [[simdgroup_index_in_threadgroup]]) {
+    const uint r0 = 16 * tg.y, c0 = 32 * tg.x, groups = a.k / 32;
+    x += long(tg.z) * a.xs;
+    sx += long(tg.z) * a.sxs;
+    w += long(tg.z) * a.ws;
+    sw += long(tg.z) * a.ss;
+    y = (device bfloat*)((device char*)y + long(tg.z) * a.ys);
+    fp8_tensor left((device uchar*)x + r0 * a.k, dextents<int32_t, 2>(a.k, 16));
+    fp8_tensor right((device uchar*)w + c0 * a.k, dextents<int32_t, 2>(a.k, 32));
+    matmul2d<ord_desc, execution_simdgroup> op;
+    const uint hx = (lane & 8) + ((lane & 1) << 2), hy = ((lane & 16) >> 2) | ((lane >> 1) & 3);
+    threadgroup float terms[S][MaxRows][32];
+    const uint per_sg = (MaxRows + S - 1) / S;
+    float sum[2] = {};
+    for (uint base = 0; base < groups; base += S) {
+        const uint g = base + sg;
+        if (g < groups) {
+            auto xa = left.slice<32, 16>(32 * g, 0);
+            auto wb = right.slice<32, 32>(32 * g, 0);
+            auto part = op.get_destination_cooperative_tensor<decltype(xa), decltype(wb), float>();
+            op.run(xa, wb, part);
+            const float ws = ord_e8m0(sw[tg.x * groups + g]);
+            const float2 as = float2(sx[(r0 + hy) * groups + g], sx[(r0 + hy + 8) * groups + g]);
+            #pragma unroll
+            for (uint i = 0; i < 16; ++i) {
+                const uint r = hy + 8 * ((i >> 2) & 1);
+                if (r < MaxRows && r + r0 < a.rows) terms[sg][r][hx + (i & 3) + 16 * (i >> 3)] = (part[i] * as[(i >> 2) & 1]) * ws;
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        #pragma unroll
+        for (uint h = 0; h < per_sg; ++h) {
+            const uint rr = sg + S * h;
+            if (rr < MaxRows && r0 + rr < a.rows) {
+                #pragma unroll
+                for (uint t = 0; t < S; ++t) if (base + t < groups) sum[h] += terms[t][rr][lane];
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    #pragma unroll
+    for (uint h = 0; h < per_sg; ++h) {
+        const uint rr = sg + S * h;
+        if (rr < MaxRows && r0 + rr < a.rows) y[(r0 + rr) * a.n + c0 + lane] = bfloat(sum[h]);
+    }
+}
+template [[host_name("ordered_small_8")]] [[kernel]] decltype(ordered_small<8, 16>) ordered_small<8, 16>;
+template [[host_name("verify_small_16")]] [[kernel]] decltype(ordered_small<16, 8>) ordered_small<16, 8>;
