+// 64x64 Metal 4.1 NAX dense FP8 matmul (4 simdgroups per tile, complete 64x64 tiles).
+template <bool TileCodes, bool TileScales>
+kernel void ordered_wide(const device uchar* x [[buffer(0)]], const device uchar* w [[buffer(1)]],
+                         const device uchar* sw [[buffer(2)]], device bfloat* y [[buffer(3)]],
+                         constant OrderedArgs& a [[buffer(4)]], const device float* sx [[buffer(5)]],
+                         uint3 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {
+    constexpr auto cfg = matmul2d_descriptor(64, 64, 32, false, true, false, matmul2d_descriptor::mode::multiply);
+    matmul2d<cfg, execution_simdgroups<4>> op;
+    const uint r0 = 64 * tg.y, c0 = 64 * tg.x, groups = a.k / 32;
+    x += long(tg.z) * a.xs;
+    sx += long(tg.z) * a.sxs;
+    w += long(tg.z) * a.ws;
+    sw += long(tg.z) * a.ss;
+    y = (device bfloat*)((device char*)y + long(tg.z) * a.ys);
+    fp8_tensor right((device uchar*)w + ulong(c0) * a.k, dextents<int32_t, 2>(a.k, 64));
+    const uint base_row = r0 + ((tid >> 1) & 3) + ((tid & 16) >> 2) + ((tid & 64) >> 2);
+    const uint base_col = c0 + ((tid & 1) << 2) + (tid & 8) + ((tid & 32) >> 1);
+    float sum[32] = {};
+    for (uint g = 0; g < groups; ++g) {
+        fp8_tensor left((device uchar*)x + ulong(r0) * a.k + (TileCodes ? ulong(g) * 64u * 32u : 0ul),
+                        dextents<int32_t, 2>(TileCodes ? 32u : a.k, 64));
+        auto xa = left.slice<32, 64>(TileCodes ? 0u : 32 * g, 0), wb = right.slice<32, 64>(32 * g, 0);
+        auto part = op.get_destination_cooperative_tensor<decltype(xa), decltype(wb), float>();
+        op.run(xa, wb, part);
+        const float2 ws = float2(ord_e8m0(sw[(c0 / 32) * groups + g]), ord_e8m0(sw[(c0 / 32 + 1) * groups + g]));
+        const ulong scale_base = TileScales ? ulong(r0) * groups + ulong(g) * 64u + (base_row - r0) : ulong(base_row) * groups + g;
+        const ulong stride = TileScales ? 1ul : ulong(groups);
+        const float4 as = float4(sx[scale_base], sx[scale_base + 8 * stride],
+                                 sx[scale_base + 32 * stride], sx[scale_base + 40 * stride]);
+        #pragma unroll
+        for (uint i = 0; i < 32; ++i)
+            sum[i] += (part[i] * as[((i & 4) >> 2) | ((i & 16) >> 3)]) * ws[(i >> 3) & 1];
+    }
+    #pragma unroll
+    for (uint i = 0; i < 32; ++i) {
+        const uint row = base_row + ((i & 4) << 1) + ((i & 16) << 1);
+        const uint col = base_col + (i & 3) + ((i & 8) << 2);
+        y[ulong(row) * a.n + col] = bfloat(sum[i]);
+    }
+}
+template [[host_name("ordered_wide_bf16")]] [[kernel]] decltype(ordered_wide<false,false>) ordered_wide<false,false>;
+template [[host_name("ordered_wide_scale_tiles")]] [[kernel]] decltype(ordered_wide<false,true>) ordered_wide<false,true>;
+template [[host_name("ordered_wide_input_tiles")]] [[kernel]] decltype(ordered_wide<true,true>) ordered_wide<true,true>;
