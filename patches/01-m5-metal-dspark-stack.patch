+    else if (rp == 4) ds_upc_pass<4>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, r0, rn, nl, n, c);
+    else if (rp == 6) ds_upc_pass<6>(vals, XH, XS, pairs, act, a, wts, wp, ws, first, r0, rn, nl, n, c);
