+    device const uint* pairs [[buffer(4)]], device bfloat* out [[buffer(5)]], constant XpArgs& a [[buffer(6)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint t [[thread_index_in_threadgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {
+  threadgroup ushort4 xb[3072 / 32 * DS_GS / 4];
+  if (tg.y >= nslots[0] || slots[3 * tg.y + 2] != 1) return;
+  const uint e = slots[3 * tg.y], first = slots[3 * tg.y + 1];
+  const ExpertPtrs w = table[e];
+  const uint n = tg.x * 32 + sg * 4 + (lane >> 3), c = lane & 7, rowb = a.K / 2, groups = a.K / 32;
+  for (uint i = t; i < a.K / 4; i += 256) xb[(i / 8) * (DS_GS / 4) + i % 8] = ((device const ushort4*)(act + first * a.K))[i];
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  device const uchar* wp = w.w2p + n * rowb;
+  device const uchar* ws = w.w2s + n * groups;
+  float acc = 0.0f;
+  for (uint g = c; g < groups; g += 8) {
+    const uint2 q0 = *(device const uint2*)(wp + 16 * g), q1 = *(device const uint2*)(wp + 16 * g + 8);
+    threadgroup const ushort4* x = xb + g * (DS_GS / 4);
+    float s = 0.0f;
+    for (int h = 0; h < 2; ++h) {
+      float wlo[8], whi[8];
+      ds_fp4_word(h == 0 ? q0.x : q1.x, wlo);
+      ds_fp4_word(h == 0 ? q0.y : q1.y, whi);
+      for (int i = 0; i < 4; ++i) {
+        const float4 x4 = float4(as_type<bfloat4>(x[4 * h + i]));
+        for (int j = 0; j < 4; ++j)
+          s = fma(x4[j], (4 * i + j < 8 ? wlo[4 * i + j] : whi[4 * i + j - 8]), s);
+      }
+    }
+    acc = k3_scaled_fma(s, ws[g], acc);
+  }
+  const bfloat v = bfloat(ds_xtree8_fast(acc));
+  if (c == 0) out[first * a.N + n] = v;
+}
+
+template <uint RP>
+inline void ds_down_pass_fast(device const bfloat* act, device bfloat* out, constant XpArgs& a,
+                              device const uchar* const thread (&wp)[1], device const uchar* const thread (&ws)[1],
+                              uint first, uint r0, uint rn, uint n, uint c) {
+  uint src[RP];
+  for (uint r = 0; r < RP; ++r) src[r] = first + r0 + min(r, rn - 1);
+  float acc[1][RP];
+  ds_rows_chains_fast<RP, 1, bfloat, true>(acc, act, nullptr, src, a.K, wp, ws, c);
+  for (uint r = 0; r < RP; ++r) {
+    const bfloat v = bfloat(ds_xtree8_fast(acc[0][r]));
+    if (c == 0 && r < rn) out[(first + r0 + r) * a.N + n] = v;
+  }
+}
+
+[[kernel, max_total_threads_per_threadgroup(256)]] void tf_dsv41_xp_down_rows_fast(
+    device const bfloat* act [[buffer(0)]], device const ExpertPtrs* table [[buffer(1)]],
+    device const uint* slots [[buffer(2)]], device const uint* nslots [[buffer(3)]],
+    device const uint* pairs [[buffer(4)]], device bfloat* out [[buffer(5)]], constant XpArgs& a [[buffer(6)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]]) {
+  if (tg.y >= nslots[0] || slots[3 * tg.y + 2] < 2) return;
+  const uint e = slots[3 * tg.y], first = slots[3 * tg.y + 1], count = slots[3 * tg.y + 2];
+  const ExpertPtrs w = table[e];
+  const uint n = tg.x * 32 + sg * 4 + (lane >> 3), c = lane & 7, rowb = a.K / 2, groups = a.K / 32;
+  device const uchar* const wp[1] = {w.w2p + n * rowb};
+  device const uchar* const ws[1] = {w.w2s + n * groups};
+  for (uint r0 = 0, rp; r0 < count; r0 += rp) {
+    rp = ds_tier(count - r0, true);
+    const uint rn = min(rp, count - r0);
+    if (rp == 2) ds_down_pass_fast<2>(act, out, a, wp, ws, first, r0, rn, n, c);
+    else ds_down_pass_fast<4>(act, out, a, wp, ws, first, r0, rn, n, c);
+  }
+}
diff --git a/zig/kernels/metal/deepseek_v41/experts_kimi_cert.metal b/zig/kernels/metal/deepseek_v41/experts_kimi_cert.metal
new file mode 100644
index 0000000..9842759
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/experts_kimi_cert.metal
@@ -0,0 +1,252 @@
+// DeepSeek V4.1 opt-in FP64-certified BF16 expert plan, exact double-float helpers and combine.
+#include <metal_stdlib>
+using namespace metal;
+
+#ifndef TF_CTL
+#define TF_CTL 0
+#endif
+
+struct XuDD {
+  float hi;
+  float lo;
+};
+
+inline void xu_neumaier(thread float& s, thread float& c, float v) {
+  if (!isfinite(v) || !isfinite(s)) {
+    s = s + v;
+    c = 0.0f;
+    return;
+  }
+  const float t = s + v;
+  const float err = (fabs(s) >= fabs(v)) ? ((s - t) + v) : ((v - t) + s);
+  c = c + err;
+  s = t;
+}
+
+inline void xu_neumaier_fast(thread float& s, thread float& c, float v) {
+  const float t = s + v;
+  const float bv = t - s;
+  c = c + ((s - (t - bv)) + (v - bv));
+  s = t;
+}
+
+inline XuDD xu_two_sum(float a, float b) {
+  const float s = a + b;
+  if (!isfinite(s)) return {s, 0.0f};
+  const float bb = s - a;
+  return {s, (a - (s - bb)) + (b - bb)};
+}
+
+inline XuDD xu_dd_add(XuDD a, XuDD b) {
+  if (!isfinite(a.hi) || !isfinite(b.hi)) return {a.hi + b.hi, 0.0f};
+  XuDD s = xu_two_sum(a.hi, b.hi);
+  if (!isfinite(s.hi)) return {s.hi, 0.0f};
+  const XuDD t = xu_two_sum(a.lo, b.lo);
+  s.lo = s.lo + t.hi;
+  s = xu_two_sum(s.hi, s.lo);
+  s.lo = s.lo + t.lo;
+  return xu_two_sum(s.hi, s.lo);
+}
+
+inline bfloat xu_dd_to_bf16(XuDD x) {
+  if (!isfinite(x.hi)) return bfloat(x.hi);
+  const XuDD s = xu_two_sum(x.hi, x.lo);
+  if (!isfinite(s.hi)) return bfloat(s.hi);
+  const uint u = as_type<uint>(s.hi);
+  if ((u & 0xFFFFu) == 0x8000u && s.lo != 0.0f) {
+    const bool same_sign = ((u >> 31) == (as_type<uint>(s.lo) >> 31));
+    const ushort trunc_bf = ushort(u >> 16);
+    return as_type<bfloat>(same_sign ? ushort(trunc_bf + 1u) : trunc_bf);
+  }
+  const uint lsb = (u >> 16) & 1u;
+  return as_type<bfloat>(ushort((u + 0x7FFFu + lsb) >> 16));
+}
+
+// Two E2M1 codes of a byte as half bits scaled by 2^-14 (0.5 is a half subnormal), low nibble first.
+inline float2 k3_fp4_pair(uint b) {
+  const uint mags = ((b & 0x77u) * 0x00200200u) & 0x0E000E00u;
+  const uint signs = ((b & 0x88u) * 0x01001000u) & 0x80008000u;
+  return float2(as_type<half2>(mags | signs));
+}
+
+// E8M0 scale 2^(e-127) times 2^14 (undoing k3_fp4_pair's scale): exact for e in 0..240.
+inline float k3_e8m0(uchar e) {
+  return as_type<float>((uint(e) + 14u) << 23);
+}
+
+// Exact double-float scaled add: power-of-two scale is exact on hi and lo, split in two normals past e=240.
+inline XuDD k3_scaled_dd(XuDD p, uchar e, XuDD acc) {
+  if (e == 255u) return {NAN, 0.0f};
+  if (!isfinite(p.hi)) return xu_dd_add(acc, {p.hi * (e - 1u < 240u ? k3_e8m0(e) : 1.0f), 0.0f});
+  XuDD term;
+  if (e - 1u < 240u) {
+    const float sc = k3_e8m0(e);
+    term = xu_two_sum(p.hi * sc, p.lo * sc);
+  } else {
+    const int d = int(e) - 127, d1 = d / 2;
+    const float s1 = 16384.0f * as_type<float>(uint(d1 + 127) << 23);
+    const float s2 = as_type<float>(uint(d - d1 + 127) << 23);
+    term = xu_two_sum((p.hi * s1) * s2, (p.lo * s1) * s2);
+  }
+  return xu_dd_add(acc, term);
+}
+
+struct ExpertPtrs {
+  device const uchar* w1p;
+  device const uchar* w1s;
+  device const uchar* w3p;
+  device const uchar* w3s;
+  device const uchar* w2p;
+  device const uchar* w2s;
+};
+
+struct PlanArgs {
+  uint pairs, experts, first, last;
+};
+
+constant constexpr uint NOWHERE = 0xFFFFFFFFu;
+
+[[kernel, max_total_threads_per_threadgroup(1024)]] void tf_dsv41_route_plan(
+    device const uint* ids [[buffer(0)]], device uint* slots [[buffer(1)]],
+    device uint* nslots [[buffer(2)]], device uint* pairs [[buffer(3)]],
+    device uint* where [[buffer(4)]], constant PlanArgs& a [[buffer(5)]],
+    uint t [[thread_index_in_threadgroup]], uint nt [[threads_per_threadgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {
+  threadgroup atomic_uint count[1024], cursor[1024];
+  threadgroup uint start[1024], part_n[32], part_s[32];
+  for (uint e = t; e < 1024; e += nt) {
+    atomic_store_explicit(&count[e], 0u, memory_order_relaxed);
+    atomic_store_explicit(&cursor[e], 0u, memory_order_relaxed);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (uint p = t; p < a.pairs; p += nt) {
+    const uint e = ids[p];
+    if (e >= a.first && e < a.last) atomic_fetch_add_explicit(&count[e], 1u, memory_order_relaxed);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint n = t < a.experts ? atomic_load_explicit(&count[t], memory_order_relaxed) : 0u;
+  const uint before_n = simd_prefix_exclusive_sum(n);
+  const uint before_s = simd_prefix_exclusive_sum(n > 0 ? 1u : 0u);
+  if (lane == 31) part_n[sg] = before_n + n, part_s[sg] = before_s + (n > 0 ? 1u : 0u);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  uint base_n = 0, base_s = 0;
+  for (uint g = 0; g < sg; ++g) base_n += part_n[g], base_s += part_s[g];
+  if (t < a.experts) start[t] = base_n + before_n;
+  if (t < a.experts && n > 0) {
+    slots[3 * (base_s + before_s)] = t;
+    slots[3 * (base_s + before_s) + 1] = base_n + before_n;
+    slots[3 * (base_s + before_s) + 2] = n;
+  }
+  if (t == nt - 1) {
+    uint total = 0;
+    for (uint g = 0; g < nt / 32; ++g) total += part_s[g];
+    nslots[0] = total;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (uint p = t; p < a.pairs; p += nt) {
+    const uint e = ids[p];
+    uint pos = NOWHERE;
+    if (e >= a.first && e < a.last) {
+      pos = start[e] + atomic_fetch_add_explicit(&cursor[e], 1u, memory_order_relaxed);
+      pairs[pos] = p;
+    }
+    where[p] = pos;
+  }
+}
+
+struct XpArgs {
+  uint K, N, topk, rows_max;
+  float beta, lin;
+};
+
+template <int RP>
+inline uint k3_stage(threadgroup bfloat* xs, device const bfloat* X, device const uint* pairs, uint first,
+                     uint count, uint r0, uint K, uint topk, bool by_row, uint t, uint nt) {
+  const uint rn = min(uint(RP), count - r0);
+  for (uint r = 0; r < rn; ++r) {
+    const uint p = pairs[first + r0 + r];
+    device const bfloat* src = X + (by_row ? p / topk : first + r0 + r) * K;
+    for (uint i = t; i < K / 4; i += nt) ((threadgroup uint2*)(xs + r * K))[i] = ((device const uint2*)src)[i];
+  }
+  return rn;
+}
+
+template <int RP, int NW>
+inline void k3_xp_chains_dd(thread XuDD (&acc)[NW][RP], threadgroup const bfloat* xs, uint K, uint rn,
+                            device const uchar* const thread (&wp)[NW], device const uchar* const thread (&ws)[NW],
+                            uint c) {
+  const uint G = K / 32;
+  const uint Ge = (TF_CTL == 2 && G > 1u) ? (G - 1u) : G;
+  for (int v = 0; v < NW; ++v)
+    for (int r = 0; r < RP; ++r) acc[v][r] = {0.0f, 0.0f};
+  for (uint g = c; g < Ge; g += 8) {
+    float hi[NW][RP], lo[NW][RP];
+    for (int v = 0; v < NW; ++v)
+      for (int r = 0; r < RP; ++r) {
+        hi[v][r] = 0.0f;
+        lo[v][r] = 0.0f;
+      }
+    for (int h = 0; h < 2; ++h) {
+      float w[NW][16];
+      for (int v = 0; v < NW; ++v) {
+        const uint2 q = *(device const uint2*)(wp[v] + 16 * g + 8 * h);
+        for (int b = 0; b < 8; ++b) {
+          const float2 f = k3_fp4_pair(((b < 4 ? q.x : q.y) >> (8 * (b & 3))) & 0xFFu);
+          w[v][2 * b] = f.x;
+          w[v][2 * b + 1] = f.y;
+        }
+      }
+      for (int r = 0; r < RP; ++r) {
+        if (uint(r) >= rn) break;
+        threadgroup const bfloat* x = xs + r * K + 32 * g + 16 * h;
+        for (int j = 0; j < 16; j += 2) {
+          float2 x2 = float2(*(threadgroup const bfloat2*)(x + j));
+          if (TF_CTL == 1) x2 = select(x2, float2(0.0f), !isfinite(x2));
+          for (int v = 0; v < NW; ++v) {
+            xu_neumaier(hi[v][r], lo[v][r], x2.x * w[v][j]);
+            xu_neumaier(hi[v][r], lo[v][r], x2.y * w[v][j + 1]);
+          }
+        }
+      }
+    }
+    for (int v = 0; v < NW; ++v)
+      for (int r = 0; r < RP; ++r) {
+        if (TF_CTL == 3) {
+          hi[v][r] = float(half(hi[v][r]));
+          lo[v][r] = 0.0f;
+        }
+        acc[v][r] = k3_scaled_dd(xu_two_sum(hi[v][r], lo[v][r]), ws[v][g], acc[v][r]);
+      }
+  }
+}
+
+inline XuDD k3_xtree8_dd(XuDD v) {
+  for (ushort d = 1; d < 8; d <<= 1) {
+    const XuDD other = {simd_shuffle_xor(v.hi, d), simd_shuffle_xor(v.lo, d)};
+    v = xu_dd_add(v, other);
+  }
+  return v;
+}
+
+template <typename OutT>
+[[kernel, max_total_threads_per_threadgroup(256)]] void tf_dsv41_xp_combine(
+    device const bfloat* out [[buffer(0)]], device const uint* where [[buffer(1)]],
+    device const float* weights [[buffer(2)]], device OutT* y [[buffer(3)]],
+    device const uint* ids [[buffer(4)]], constant XpArgs& a [[buffer(5)]],
+    constant uint3& g [[buffer(6)]], uint2 gid [[thread_position_in_grid]]) {
+  if (gid.x >= a.N) return;
+  float part[8];
+  for (uint i = 0; i < 8; ++i) part[i] = 0.0f;
+  for (uint k = 0; k < a.topk; ++k) {
+    const uint p = where[gid.y * a.topk + k];
+    if (p == NOWHERE) continue;
+    const uint grp = ids[gid.y * a.topk + k] / g.x - g.y;
+    part[grp] = fma(weights[gid.y * a.topk + k], float(out[p * a.N + gid.x]), part[grp]);
+  }
+  for (uint w = g.z; w > 1; w /= 2)
+    for (uint i = 0; i < w / 2; ++i) part[i] = part[2 * i] + part[2 * i + 1];
+  y[gid.y * a.N + gid.x] = OutT(part[0]);
+}
+
+template [[host_name("tf_dsv41_xp_combine")]] [[kernel]] decltype(tf_dsv41_xp_combine<bfloat>) tf_dsv41_xp_combine<bfloat>;
+template [[host_name("tf_dsv41_xp_combine_f32")]] [[kernel]] decltype(tf_dsv41_xp_combine<float>) tf_dsv41_xp_combine<float>;
diff --git a/zig/kernels/metal/deepseek_v41/experts_units_cert.metal b/zig/kernels/metal/deepseek_v41/experts_units_cert.metal
new file mode 100644
index 0000000..c7206ee
--- /dev/null
+++ b/zig/kernels/metal/deepseek_v41/experts_units_cert.metal
@@ -0,0 +1,346 @@
+// DeepSeek V4.1 opt-in FP64-certified BF16 prompt experts on M5 Ultra Metal 4.1 tensor units (Pass 1).
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+
+#define XU_RT 32u
+
+struct XmArgs {
+  uint K, N, topk, pairs;
+  float limit;
+};
+
+struct XuPatchArgs {
+  uint patch_cap;
+  uint ug_cap;
+};
+
+[[kernel, max_total_threads_per_threadgroup(32)]] void tf_dsv41_xu_tiles(
+    device const uint* slots [[buffer(0)]], device const uint* nslots [[buffer(1)]], device uint4* tiles [[buffer(2)]],
+    uint t [[thread_index_in_threadgroup]]) {
+  if (t != 0) return;
+  uint n = 0;
+  for (uint s = 0; s < nslots[0]; ++s)
+    for (uint r = 0; r < slots[3 * s + 2]; r += XU_RT)
+      tiles[1 + n++] = uint4(slots[3 * s], slots[3 * s + 1] + r, min(XU_RT, slots[3 * s + 2] - r), 0u);
+  tiles[0] = uint4(n, 0u, 0u, 0u);
+}
+
+inline half xu_h(uint c) {
+  return as_type<half>(ushort(((c & 0x7Fu) << 7) | ((c & 0x80u) << 8))) * 256.0h;
+}
+
+inline uint xu_int(uint c) {
+  const uint e = (c >> 3) & 15u, m = c & 7u;
+  return e == 0 ? m : (8u + m) << (e - 1);
+}
+
+inline bool xu_exact(ulong sum, ulong low) {
+  return low == 0 || 12 * sum < (ulong(1) << 24) * low;
+}
+
+inline uint xu_pos(uint k) {
+  return 2 * (k & 12u) + (k & 3u) + ((k & 16u) >> 2);
+}
+
+// Quantize BF16 X to swizzled exact half + scales and build a per-row 256-bit unsafe-group bitmask.
+[[kernel, max_total_threads_per_threadgroup(128)]] void tf_dsv41_xu_quant_ug(
+    device const bfloat* X [[buffer(0)]], device half* xc [[buffer(1)]], device float* xs [[buffer(2)]],
+    constant uint3& a [[buffer(3)]], device uint* unsafe_mask [[buffer(4)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {
+  const uint K = a.x, rows = a.y, ug_cap = a.z, G = K >> 5, row = tg.y;
+  if (row >= rows) return;
+  threadgroup atomic_uint tg_mask[8];
+  if (tid < 8u) atomic_store_explicit(&tg_mask[tid], 0u, memory_order_relaxed);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (uint g = tid; g < G; g += 128u) {
+    device const uint4* src = (device const uint4*)(X + ulong(row) * K + (g << 5));
+    float v[32], amax = 0.0f;
+    bool bad = false;
+    for (uint q = 0; q < 4; ++q)
+      for (uint m = 0; m < 4; ++m) {
+        const float2 f = float2(as_type<bfloat2>(src[q][m]));
+        v[8 * q + 2 * m] = f.x, v[8 * q + 2 * m + 1] = f.y;
+      }
+    for (uint j = 0; j < 32; ++j) {
+      if (TF_CTL == 1 && !isfinite(v[j])) v[j] = 0.0f;
+      bad |= !isfinite(v[j]);
+      amax = max(amax, fabs(v[j]));
+    }
+    const int e = ds_exp(amax);
+    uint sum = 0, bits = 0;
+    half h[32];
+    for (uint j = 0; j < 32; ++j) {
+      const uint c = ds_code(min(fabs(v[j]) * ds_pow2(-e), 448.0f), signbit(v[j]));
+      sum += xu_int(c), bits |= xu_int(c);
+      h[xu_pos(j)] = xu_h(c);
+    }
+    device half4* dst = (device half4*)(xc + ulong(row) * K + (g << 5));
+    for (uint q = 0; q < 8; ++q) dst[q] = half4(h[4 * q], h[4 * q + 1], h[4 * q + 2], h[4 * q + 3]);
+    const bool safe = !bad && xu_exact(sum, bits & (~bits + 1u));
+    xs[ulong(row) * G + g] = bad ? -NAN : (safe ? 1.0f : -1.0f) * ds_pow2(e);
+    if (!safe) atomic_fetch_or_explicit(&tg_mask[g >> 5], 1u << (g & 31u), memory_order_relaxed);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tid < 8u && row < ug_cap) unsafe_mask[ulong(row) * 8u + tid] = atomic_load_explicit(&tg_mask[tid], memory_order_relaxed);
+}
+
+inline float xu_max8(float x) {
+  for (ushort d = 1; d < 8; d <<= 1) x = max(x, simd_shuffle_xor(x, d));
+  return x;
+}
+
+inline int xu_min8(int x) {
+  for (ushort d = 1; d < 8; d <<= 1) x = min(x, simd_shuffle_xor(x, d));
+  return x;
+}
+
+inline uint xu_sum8(uint x) {
+  for (ushort d = 1; d < 8; d <<= 1) x += simd_shuffle_xor(x, d);
+  return x;
+}
+
+// Prepare swizzled half activations for xu_down and build a per-pair 256-bit unsafe-group bitmask.
+[[kernel, max_total_threads_per_threadgroup(256)]] void tf_dsv41_xu_dprep_ug(
+    device const bfloat* act [[buffer(0)]], device half* dh [[buffer(1)]], device float* ds [[buffer(2)]],
+    constant uint3& a [[buffer(3)]], device uint* unsafe_mask [[buffer(4)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {
+  const uint K = a.x, rows = a.y, ug_cap = a.z, G = K >> 5, row = tg.y;
+  if (row >= rows) return;
+  threadgroup atomic_uint tg_mask[8];
+  if (tid < 8u) atomic_store_explicit(&tg_mask[tid], 0u, memory_order_relaxed);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint sub = tid & 7u;
+  for (uint g_base = 0u; g_base < G; g_base += 32u) {
+    const uint g = g_base + (tid >> 3);
+    if (g < G) {
+      const uint k = (g << 5) + (sub << 2);
+      const uint2 raw = *(device const uint2*)(act + ulong(row) * K + k);
+      float v[4];
+      float top = 0.0f, bad = 0.0f;
+      for (int i = 0; i < 4; ++i) {
+        v[i] = as_type<float>(((raw[i / 2] >> (16 * (i % 2))) & 0xFFFFu) << 16);
+        if (TF_CTL == 1 && !isfinite(v[i])) v[i] = 0.0f;
+        top = max(top, fabs(v[i]));
+        bad = isfinite(v[i]) ? bad : 1.0f;
+      }
+      const float amax = xu_max8(top);
+      const int e = amax > 0.0f ? ilogb(amax) : 0;
+      int lb[4], low = 1 << 20;
+      for (int i = 0; i < 4; ++i) {
+        const uint b = as_type<uint>(v[i]) & 0x7FFFFFFFu;
+        lb[i] = b != 0 ? int(b >> 23) - 150 + int(ctz(b | 0x800000u)) : 1 << 20;
+        low = min(low, lb[i]);
+      }
+      low = xu_min8(low);
+      uint sum = 0;
+      for (int i = 0; i < 4; ++i) {
+        const uint b = as_type<uint>(v[i]) & 0x7FFFFFFFu, odd = ((b & 0x7FFFFFu) | 0x800000u) >> ctz(b | 0x800000u);
+        const int sh = lb[i] - low;
+        sum += b == 0 ? 0u : (sh >= 21 || odd >= (1u << (21 - sh)) ? 1u << 21 : odd << sh);
+      }
+      const bool exact = amax == 0.0f || (amax >= 0x1p-60f && 12u * xu_sum8(sum) < (1u << 24));
+      const bool safe = xu_max8(bad) == 0.0f && exact;
+      const float f = ds_pow2(9 - e);
+      const half4 h = safe ? half4(half(v[0] * f), half(v[1] * f), half(v[2] * f), half(v[3] * f)) : half4(0.0h);
+      *(device half4*)(dh + ulong(row) * K + (g << 5) + xu_pos(sub << 2)) = h;
+      if (sub == 0u) {
+        ds[ulong(row) * G + g] = (safe ? 1.0f : -1.0f) * ds_pow2(e - 9);
+        if (!safe) atomic_fetch_or_explicit(&tg_mask[g >> 5], 1u << (g & 31u), memory_order_relaxed);
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tid < 8u && row < ug_cap) unsafe_mask[ulong(row) * 8u + tid] = atomic_load_explicit(&tg_mask[tid], memory_order_relaxed);
+}
+
+[[kernel, max_total_threads_per_threadgroup(32)]] void tf_dsv41_xu_zero_cnt(
+    device uint* cnt [[buffer(0)]], uint tid [[thread_index_in_threadgroup]]) {
+  if (tid == 0u) cnt[0] = 0u;
+}
+
+using namespace mpp::tensor_ops;
+constexpr constant auto xu_shape = matmul2d_descriptor(16, 32, 32, false, true, false, matmul2d_descriptor::mode::multiply);
+using xu_wt = tensor<device metal_fp4_e2m1_format, dextents<int32_t, 2>, tensor_inline>;
+
+// Zero-spill Pass-1 chain: accumulates safe groups in 48-bit dd and flags unsafe/abnormal rows for Pass 2.
+inline uint xu_chain_fast(thread float (&cur)[16], thread float (&comp)[16], device const uchar* wp, device const uchar* ws,
+                          device const half* xb, device const float* sb, const thread uint (&rb)[2],
+                          uint hx, uint hy, uint K) {
+  const uint G = K / 32;
+  matmul2d<xu_shape, execution_simdgroup> op;
+  xu_wt wt((device uchar*)wp, dextents<int32_t, 2>(K, 32));
+  const uint Ge = TF_CTL == 5 ? G - 1 : G;
+  _Pragma("unroll") for (int i = 0; i < 16; ++i) {
+    cur[i] = 0.0f;
+    comp[i] = 0.0f;
+  }
+  bool bad0 = false, bad1 = false, any_abn = false;
+  for (uint g = 0; g < Ge; ++g) {
+    const uint4 x0 = *(device const uint4*)(xb + rb[0] + 32 * g + 2 * hx);
+    const uint4 x1 = *(device const uint4*)(xb + rb[1] + 32 * g + 2 * hx);
+    auto wg = wt.slice<32, 32>(32 * g, 0);
+    auto left = op.get_left_input_cooperative_tensor<half, metal_fp4_e2m1_format, float>();
+    auto acc = op.get_destination_cooperative_tensor<metal::remove_addrspace_t<decltype(left)>,
+                                                     metal::remove_addrspace_t<decltype(wg)>, float>();
+    _Pragma("unroll") for (int i = 0; i < 16; ++i) {
+      const uint j = (i & 3) + 4 * (i >> 3);
+      left[i] = as_type<half2>(((i >> 2) & 1 ? x1 : x0)[j >> 1])[j & 1];
+    }
+    op.run(left, wg, acc);
+    const float s0 = sb[rb[0] / 32 + g], s1 = sb[rb[1] / 32 + g];
+    const bool u0 = (TF_CTL != 6) && (signbit(s0) || !isfinite(s0));
+    const bool u1 = (TF_CTL != 6) && (signbit(s1) || !isfinite(s1));
+    bad0 |= u0;
+    bad1 |= u1;
+    const float sf0 = u0 ? 0.0f : (s0 * 0x1p-14f);
+    const float sf1 = u1 ? 0.0f : (s1 * 0x1p-14f);
+    float ks[8];
+    bool abn = false;
+    _Pragma("unroll") for (int j = 0; j < 8; ++j) {
+      const uchar e = ws[(hx + (j & 3) + 16 * (j >> 2)) * G + g];
+      const bool ok = (e <= 240u);
+      abn |= !ok;
+      ks[j] = ok ? k3_e8m0(e) : 0.0f;
+    }
+    if (abn) {
+      bad0 = true;
+      bad1 = true;
+      any_abn = true;
+    }
+    _Pragma("unroll") for (int i = 0; i < 16; ++i) {
+      const bool skip = ((i >> 2) & 1) ? u1 : u0;
+      const float ksc = ks[(i & 3) + 4 * (i >> 3)];
+      float term = (skip || ksc == 0.0f) ? 0.0f : (acc[i] * ((i >> 2) & 1 ? sf1 : sf0)) * ksc;
+      if (TF_CTL == 3) term = float(half(term));
+      xu_neumaier_fast(cur[i], comp[i], term);
+    }
+  }
+  return simd_or((bad0 ? (1u << hy) : 0u) | (bad1 ? (256u << hy) : 0u) | (any_abn ? (1u << 16) : 0u));
+}
+
+inline short2 xu_home(ushort l) {
+  return short2(short((l & 8) + ((l & 1) << 2)), short(((l & 16) >> 2) | ((l >> 1) & 3)));
+}
+
+// 32-row Pass 1 for xu_up: 4 simdgroups (128T) = 2 x 16-row chunks x (W1, W3), 16 KiB TG memory.
+[[kernel, max_total_threads_per_threadgroup(128)]] void tf_dsv41_xu_up(
+    device const half* xc [[buffer(0)]], device const float* xs [[buffer(1)]], device const ExpertPtrs* table [[buffer(2)]],
+    device const uint4* tiles [[buffer(3)]], device const uint* pairs [[buffer(4)]], device bfloat* act [[buffer(5)]],
+    constant XmArgs& a [[buffer(6)]], device const float* wts [[buffer(7)]],
+    device uint4* patch_meta [[buffer(8)]], device float4* patch_vals [[buffer(9)]],
+    device atomic_uint* patch_cnt [[buffer(10)]], constant XuPatchArgs& pa [[buffer(11)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float gv_hi[32][32];
+  threadgroup float gv_lo[32][32];
+  threadgroup float u_hi[32][32];
+  threadgroup float u_lo[32][32];
+  threadgroup uint bm_sm[4];
+  if (tg.y >= tiles[0].x) return;
+  const uint4 tile = tiles[1 + tg.y];
+  const ExpertPtrs w = table[tile.x];
+  const short2 home = xu_home(lane);
+  const uint hx = home.x, hy = home.y;
+  const uint K = a.K, G = K / 32, n0 = tg.x * 32, first = tile.y, nr = tile.z;
+  const uint chunk = sg >> 1, mat = sg & 1u;
+  const uint r_base = chunk * 16u;
+  const uint r_cnt = (nr > r_base) ? min(16u, nr - r_base) : 0u;
+  float cur[16], comp[16];
+  uint bm_local = 0u;
+  if (r_cnt > 0u) {
+    uint rb[2];
+    for (int h = 0; h < 2; ++h) rb[h] = (pairs[first + r_base + min(hy + 8 * h, r_cnt - 1)] / a.topk) * K;
+    device const uchar* wp = (mat == 0u ? w.w1p : w.w3p) + n0 * (K / 2);
+    device const uchar* ws = (mat == 0u ? w.w1s : w.w3s) + n0 * G;
+    bm_local = xu_chain_fast(cur, comp, wp, ws, xc, xs, rb, hx, hy, K);
+    if (mat == 0u) {
+      for (int i = 0; i < 16; ++i) {
+        const uint lr = r_base + hy + 8 * ((i >> 2) & 1), col = hx + (i & 3) + 16 * (i >> 3);
+        gv_hi[lr][col] = cur[i];
+        gv_lo[lr][col] = comp[i];
+      }
+    } else {
+      for (int i = 0; i < 16; ++i) {
+        const uint lr = r_base + hy + 8 * ((i >> 2) & 1), col = hx + (i & 3) + 16 * (i >> 3);
+        u_hi[lr][col] = cur[i];
+        u_lo[lr][col] = comp[i];
+      }
+    }
+  }
+  if (lane == 0u) bm_sm[sg] = bm_local;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (r_cnt > 0u) {
+    const uint bm = bm_sm[2u * chunk] | bm_sm[2u * chunk + 1u];
+    for (uint r = mat; r < r_cnt; r += 2u) {
+      const uint lr = r_base + r;
+      const uint pair_pos = first + lr;
+      if ((bm & (1u << r)) == 0u) {
+        const float g = ds_clip(float(xu_dd_to_bf16({gv_hi[lr][lane], gv_lo[lr][lane]})), -INFINITY, a.limit);
+        const float u = ds_clip(float(xu_dd_to_bf16({u_hi[lr][lane], u_lo[lr][lane]})), -a.limit, a.limit);
+        const float v = g / (1.0f + precise::exp(-g)) * u * wts[pairs[pair_pos]];
+        const float vv = TF_CTL == 2 ? v : float(bfloat(v));
+        const float amax = simd_max(fabs(vv));
+        const bool bad = simd_any(!isfinite(vv));
+        const int s = ds_exp(amax);
+        const float q = ds_val(ds_code(min(fabs(vv) * ds_pow2(-s), 448.0f), signbit(vv))) * ds_pow2(s);
+        act[ulong(pair_pos) * a.N + n0 + lane] = bfloat(bad ? NAN : q);
+      } else {
+        uint slot = 0u;
+        if (lane == 0u) {
+          slot = atomic_fetch_add_explicit(patch_cnt, 1u, memory_order_relaxed);
+          if (slot < pa.patch_cap) patch_meta[slot] = uint4(pair_pos, tile.x, n0, bm >> 16);
+        }
+        slot = simd_shuffle(slot, 0);
+        if (slot < pa.patch_cap)
+          patch_vals[ulong(slot) * 32u + lane] = float4(gv_hi[lr][lane], gv_lo[lr][lane], u_hi[lr][lane], u_lo[lr][lane]);
+      }
+    }
+  }
+  if (TF_CTL == 4 && tg.x == 0 && tg.y == 0 && sg == 0 && lane == 0) act[a.pairs * a.N] = bfloat(1.0f);
+}
+
+// 32-row Pass 1 for xu_down: 2 simdgroups (64T) share 32 W2 columns via xu_chain_fast, 8 KiB TG memory.
+[[kernel, max_total_threads_per_threadgroup(64)]] void tf_dsv41_xu_down(
+    device const bfloat* act [[buffer(0)]], device const ExpertPtrs* table [[buffer(1)]],
+    device const uint4* tiles [[buffer(2)]], device bfloat* out [[buffer(3)]], constant XmArgs& a [[buffer(4)]],
+    device const half* dh [[buffer(5)]], device const float* ds [[buffer(6)]],
+    device uint4* patch_meta [[buffer(7)]], device float2* patch_vals [[buffer(8)]],
+    device atomic_uint* patch_cnt [[buffer(9)]], constant XuPatchArgs& pa [[buffer(10)]],
+    uint2 tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float hi_sm[2][16][32];
+  threadgroup float lo_sm[2][16][32];
+  if (tg.y >= tiles[0].x) return;
+  const uint4 tile = tiles[1 + tg.y];
+  const ExpertPtrs w = table[tile.x];
+  const short2 home = xu_home(lane);
+  const uint hx = home.x, hy = home.y;
+  const uint K = a.K, G = K >> 5, n0 = tg.x * 32u, first = tile.y, nr = tile.z;
+  const uint r_base = sg * 16u;
+  if (n0 < a.N && r_base < nr) {
+    const uint r_cnt = min(16u, nr - r_base);
+    uint rb[2];
+    for (int h = 0; h < 2; ++h) rb[h] = (first + r_base + min(hy + 8u * h, r_cnt - 1u)) * K;
+    float cur[16], comp[16];
+    const uint bm = xu_chain_fast(cur, comp, w.w2p + ulong(n0) * (K >> 1), w.w2s + ulong(n0) * G, dh, ds, rb, hx, hy, K);
+    for (int i = 0; i < 16; ++i) {
+      const uint lr = hy + 8 * ((i >> 2) & 1), col = hx + (i & 3) + 16 * (i >> 3);
+      hi_sm[sg][lr][col] = cur[i];
+      lo_sm[sg][lr][col] = comp[i];
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint r = 0u; r < r_cnt; ++r) {
+      const uint pair_pos = first + r_base + r;
+      if ((bm & (1u << r)) == 0u) {
+        out[ulong(pair_pos) * a.N + n0 + lane] = xu_dd_to_bf16({hi_sm[sg][r][lane], lo_sm[sg][r][lane]});
+      } else {
+        uint slot = 0u;
+        if (lane == 0u) {
+          slot = atomic_fetch_add_explicit(patch_cnt, 1u, memory_order_relaxed);
+          if (slot < pa.patch_cap) patch_meta[slot] = uint4(pair_pos, tile.x, n0, bm >> 16);
+        }
+        slot = simd_shuffle(slot, 0);
+        if (slot < pa.patch_cap)
+          patch_vals[ulong(slot) * 32u + lane] = float2(hi_sm[sg][r][lane], lo_sm[sg][r][lane]);
+      }
+    }
+  }
+  if (TF_CTL == 4 && tg.x == 0 && tg.y == 0 && sg == 0 && lane == 0) out[a.pairs * a.N] = bfloat(1.0f);
+}
