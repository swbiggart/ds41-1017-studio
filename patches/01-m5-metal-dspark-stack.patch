+inline XuDD ds_dgroup_dd(XuDD acc, device const uchar* q, threadgroup const ushort4* x, uchar s) {
+  const uint2 q0 = *(device const uint2*)q, q1 = *(device const uint2*)(q + 8);
+  float hi = 0.0f, lo = 0.0f;
+  for (int h = 0; h < 2; ++h) {
+    float wlo[8], whi[8];
+    ds_fp4_word(h == 0 ? q0.x : q1.x, wlo);
+    ds_fp4_word(h == 0 ? q0.y : q1.y, whi);
+    for (int i = 0; i < 4; ++i) {
+      float4 x4 = float4(as_type<bfloat4>(x[4 * h + i]));
+      if (TF_CTL == 1) x4 = select(x4, float4(0.0f), !isfinite(x4));
+      for (int j = 0; j < 4; ++j)
+        xu_neumaier(hi, lo, x4[j] * (4 * i + j < 8 ? wlo[4 * i + j] : whi[4 * i + j - 8]));
+    }
+  }
+  if (TF_CTL == 3) {
+    hi = float(half(hi));
+    lo = 0.0f;
+  }
+  return k3_scaled_dd(xu_two_sum(hi, lo), s, acc);
+}
