+    pub fn deinit(p: *Pipelines) void {
+        p.f32.deinit();
+        p.norm_w.deinit();
+        p.prep_x.deinit();
+        p.zero_cnt.deinit();
+        p.gemm.deinit();
+        p.repair.deinit();
+        p.fast_bf16.deinit();
+        p.fast_f32.deinit();
